diff --git a/apps/praxis-desktop/renderer/src/notes/noteSendReference.ts b/apps/praxis-desktop/renderer/src/notes/noteSendReference.ts
new file mode 100644
index 00000000..d17b8d8f
--- /dev/null
+++ b/apps/praxis-desktop/renderer/src/notes/noteSendReference.ts
@@ -0,0 +1,39 @@
+import type { AgentSessionRecord, NoteRequestSnapshot } from '@praxis/core';
+import type { SessionContextReference } from '../ai/sessionContext';
+
+/** Copies a captured snapshot into a context reference; later edits to the notes can't change it. */
+export function snapshotToReference(snapshot: NoteRequestSnapshot): SessionContextReference {
+  const content = snapshot.notes.map((note, index) => `${index + 1}. ${note.title}\n\n${note.body}`).join('\n\n---\n\n');
+  if (snapshot.source.kind === 'note') {
+    return { id: `note:${snapshot.source.id}@${snapshot.capturedAt}`, kind: 'note', label: `Note: ${snapshot.source.title}`, content, capturedAt: snapshot.capturedAt };
+  }
+  const count = snapshot.notes.length;
+  return {
+    id: `note-group:${snapshot.source.id}@${snapshot.capturedAt}`, kind: 'note-group',
+    label: `Group: ${snapshot.source.title} (${count} ${count === 1 ? 'note' : 'notes'})`, content, capturedAt: snapshot.capturedAt
+  };
+}
+
+/** Both session paths reject an empty message, so an empty instruction falls back to this. */
+export function defaultNoteInstruction(snapshot: NoteRequestSnapshot): string {
+  return snapshot.notes.length === 1 ? 'Use the attached note as context.' : 'Use the attached notes as context.';
+}
+
+const recency = (session: AgentSessionRecord): string => session.lastActivityAt ?? session.startedAt;
+
+/**
+ * Sessions a note can be handed to: the project's own, live, top-level sessions.
+ * Subagents, workflow stages/controllers and ticket reviews are reached through their
+ * run or ticket, so they are never offered. Most recently updated first.
+ */
+export function compatibleNoteSessions(sessions: readonly AgentSessionRecord[], projectId: string): AgentSessionRecord[] {
+  return sessions
+    .filter(session => session.projectId === projectId
+      && !session.archived
+      && !session.parentSessionKey
+      && !session.workflowRunId
+      && !session.workflowNodeId
+      && session.workflowRole !== 'controller'
+      && !session.issueKey.startsWith('review~'))
+    .sort((a, b) => recency(b).localeCompare(recency(a)));
+}
diff --git a/apps/praxis-desktop/renderer/src/notes/noteSendStore.ts b/apps/praxis-desktop/renderer/src/notes/noteSendStore.ts
new file mode 100644
index 00000000..c8488740
--- /dev/null
+++ b/apps/praxis-desktop/renderer/src/notes/noteSendStore.ts
@@ -0,0 +1,45 @@
+import { useSyncExternalStore } from 'react';
+import type { NoteSource } from '@praxis/core';
+import type { SessionContextReference } from '../ai/sessionContext';
+
+/** What the Send-to-session dialog is open for. */
+export interface NoteSendRequest { projectId: string; source: NoteSource; title: string }
+
+/** A reference staged for a session composer to send (existing session) or hold (new session). */
+export interface SessionHandoff { reference: SessionContextReference; instruction: string }
+
+/** Key under which a handoff waits for the New Session composer. */
+export const NEW_SESSION_HANDOFF = 'new';
+
+let request: NoteSendRequest | undefined;
+const listeners = new Set<() => void>();
+const handoffs = new Map<string, SessionHandoff>();
+const instructions = new Map<string, string>();
+
+const emit = () => listeners.forEach(listener => listener());
+const subscribe = (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener); }; };
+
+export const requestNoteSend = (next: NoteSendRequest) => { request = next; emit(); };
+export const closeNoteSend = () => { request = undefined; emit(); };
+export const useNoteSendRequest = (): NoteSendRequest | undefined => useSyncExternalStore(subscribe, () => request);
+
+const instructionKey = (projectId: string, source: NoteSource) => `${projectId}:${source.kind}:${source.id}`;
+/** Instructions typed but not sent survive cancelling and reopening the dialog. */
+export const draftInstruction = (projectId: string, source: NoteSource): string => instructions.get(instructionKey(projectId, source)) ?? '';
+export const saveDraftInstruction = (projectId: string, source: NoteSource, text: string) => {
+  if (text) instructions.set(instructionKey(projectId, source), text);
+  else instructions.delete(instructionKey(projectId, source));
+};
+
+export const stageSessionHandoff = (key: string, handoff: SessionHandoff) => { handoffs.set(key, handoff); emit(); };
+/** Re-renders when a handoff is staged or consumed, so an already-open session notices it. */
+export const useStagedHandoff = (key: string | undefined): SessionHandoff | undefined =>
+  useSyncExternalStore(subscribe, () => (key ? handoffs.get(key) : undefined));
+export const peekSessionHandoff = (key: string): SessionHandoff | undefined => handoffs.get(key);
+/** Consume-once: a second call returns nothing, so a handoff can't be sent twice. */
+export function takeSessionHandoff(key: string): SessionHandoff | undefined {
+  const handoff = handoffs.get(key);
+  handoffs.delete(key);
+  if (handoff) emit();
+  return handoff;
+}
