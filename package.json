{
  "name": "ticket-manager-workspace",
  "description": "Monorepo orchestrating the Ticket Manager VS Code extension, shared core, web frontend, and Electron desktop app.",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=ticket-manager",
    "compile": "npm run compile --workspace=ticket-manager",
    "package": "npm run package --workspace=ticket-manager",
    "watch": "npm run watch --workspace=ticket-manager",
    "vscode:prepublish": "npm run vscode:prepublish --workspace=ticket-manager",
    "install:all": "npm run install:all --workspace=ticket-manager",
    "uninstall:all": "npm run uninstall:all --workspace=ticket-manager",
    "build:install": "npm run build:install --workspace=ticket-manager",
    "publish:gitlab": "npm run publish:gitlab --workspace=ticket-manager",
    "install:from-gitlab": "npm run install:from-gitlab --workspace=ticket-manager",
    "install:vsix": "npm run install:vsix --workspace=ticket-manager",
    "install:code": "npm run install:code --workspace=ticket-manager",
    "install:insiders": "npm run install:insiders --workspace=ticket-manager",
    "install:cursor": "npm run install:cursor --workspace=ticket-manager",
    "open:ticket-manager": "npm run open:ticket-manager --workspace=ticket-manager",
    "docs:commands": "npm run docs:commands --workspace=ticket-manager",
    "bedrock:glm-test": "npm run bedrock:glm-test --workspace=ticket-manager",
    "bedrock:proxy": "npm run bedrock:proxy --workspace=ticket-manager",
    "clean": "npm run clean --workspace=ticket-manager",
    "check-types": "npm run check-types --workspace=ticket-manager",
    "test": "npm run test --workspace=ticket-manager",
    "jira-mr-polling": "npm run jira-mr-polling --workspace=ticket-manager",
    "jira-mr-polling:once": "npm run jira-mr-polling:once --workspace=ticket-manager",
    "jira-mr-polling:test": "npm run jira-mr-polling:test --workspace=ticket-manager",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-app.ps1",
    "app:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-app.ps1 -Dev",
    "app:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-app.ps1",
    "app:dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-app.ps1 -Target portable",
    "app:dist:dir": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-app.ps1 -Target dir",
    "frontend:dev": "npm run dev --workspace=@ticket-manager/frontend",
    "frontend:build": "npm run build --workspace=@ticket-manager/frontend",
    "electron:start": "npm run start --workspace=@ticket-manager/electron-app",
    "electron:check-types": "npm run check-types --workspace=@ticket-manager/electron-app",
    "electron:compile": "npm run compile --workspace=@ticket-manager/electron-app",
    "electron:copy-renderer": "npm run copy-renderer --workspace=@ticket-manager/electron-app",
    "electron:test": "npm run test:e2e --workspace=@ticket-manager/electron-app",
    "electron:dist": "npm run dist --workspace=@ticket-manager/electron-app"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild": true,
    "electron-builder": true
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
