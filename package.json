{
  "name": "ticket-manager",
  "displayName": "Ticket Manager",
  "version": "0.0.1",
  "publisher": "local-dev",
  "description": "A compact issue and board sidebar for VS Code with connected, demo, and file-backed modes.",
  "license": "MIT",
  "preview": true,
  "pricing": "Free",
  "type": "commonjs",
  "main": "./out/extension.js",
  "icon": "media/marketplace-icon.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "issues",
    "tickets",
    "boards",
    "mcp",
    "activity-bar",
    "sidebar"
  ],
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "rimraf out",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vscode-test --label integration",
    "install:vsix": "node ./scripts/install-vsix.cjs",
    "install:cursor": "powershell -ExecutionPolicy Bypass -File ./scripts/install-cursor-extension.ps1"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ticketManager",
          "title": "Tickets",
          "icon": "media/activitybar-ticket.svg"
        }
      ]
    },
    "views": {
      "ticketManager": [
        {
          "id": "ticketManager.myIssues",
          "name": "My Issues",
          "type": "webview",
          "contextualTitle": "Tickets",
          "icon": "media/activitybar-ticket.svg"
        },
        {
          "id": "ticketManager.epics",
          "name": "EPICs",
          "type": "webview",
          "contextualTitle": "Tickets",
          "icon": "media/activitybar-ticket.svg"
        },
        {
          "id": "ticketManager.boards",
          "name": "Boards",
          "type": "webview",
          "contextualTitle": "Tickets",
          "icon": "media/activitybar-ticket.svg"
        },
        {
          "id": "ticketManager.issueDetails",
          "name": "Issue Details",
          "type": "webview",
          "contextualTitle": "Tickets",
          "icon": "media/activitybar-ticket.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ticketManager.myIssues",
        "contents": "Welcome to Ticket Manager!\\nConfigure a project to get started.\\n[$(gear) Configure Project](command:ticketManager.openSetup)\\n\\nAlready configured? [Set Backend Mode](command:ticketManager.setBackendMode)"
      },
      {
        "view": "ticketManager.issueDetails",
        "contents": "Select an issue in **My Issues** or on a board to inspect its details and transitions."
      },
      {
        "view": "ticketManager.epics",
        "contents": "Browse and manage EPICs for the current project scope."
      },
      {
        "view": "ticketManager.boards",
        "contents": "Browse boards and open a board tab.\\n[Set Board Search](command:ticketManager.setBoardSearchText)\\n[Set Board Projects](command:ticketManager.setBoardProjects)\\n[Set Board Types](command:ticketManager.setBoardTypes)"
      }
    ],
    "commands": [
      {
        "command": "ticketManager.refresh",
        "title": "Refresh",
        "category": "Ticket Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "ticketManager.configureConnection",
        "title": "Configure Connection",
        "category": "Ticket Manager",
        "icon": "$(plug)"
      },
      {
        "command": "ticketManager.checkConnection",
        "title": "Check Connection",
        "category": "Ticket Manager",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ticketManager.setBackendMode",
        "title": "Set Backend Mode",
        "category": "Ticket Manager",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "ticketManager.openSetup",
        "title": "Configure Project",
        "category": "Ticket Manager",
        "icon": "$(gear)"
      },
      {
        "command": "ticketManager.importMarkdownFeaturePlan",
        "title": "Import Plan from Markdown Features",
        "category": "Ticket Manager",
        "icon": "$(file-code)"
      },
      {
        "command": "ticketManager.newProject",
        "title": "New Project",
        "category": "Ticket Manager",
        "icon": "$(rocket)"
      },
      {
        "command": "ticketManager.importWorkspaceMcpConfig",
        "title": "Use Workspace MCP Configuration",
        "category": "Ticket Manager",
        "icon": "$(folder-library)"
      },
      {
        "command": "ticketManager.importUserMcpConfig",
        "title": "Use User/Profile MCP Configuration",
        "category": "Ticket Manager",
        "icon": "$(account)"
      },
      {
        "command": "ticketManager.openBoard",
        "title": "Open Board",
        "category": "Ticket Manager",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ticketManager.createIssue",
        "title": "Create Issue",
        "category": "Ticket Manager",
        "icon": "$(add)"
      },
      {
        "command": "ticketManager.createBoard",
        "title": "Create Board",
        "category": "Ticket Manager",
        "icon": "$(new-folder)"
      },
      {
        "command": "ticketManager.createEpic",
        "title": "Create EPIC",
        "category": "Ticket Manager",
        "icon": "$(add)"
      },
      {
        "command": "ticketManager.searchIssues",
        "title": "Search Issues",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.searchIssuesActive",
        "title": "Search Issues",
        "category": "Ticket Manager",
        "icon": {
          "light": "media/search-active-light.svg",
          "dark": "media/search-active-dark.svg"
        }
      },
      {
        "command": "ticketManager.searchEpics",
        "title": "Search EPICs",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.searchEpicsActive",
        "title": "Search EPICs",
        "category": "Ticket Manager",
        "icon": {
          "light": "media/search-active-light.svg",
          "dark": "media/search-active-dark.svg"
        }
      },
      {
        "command": "ticketManager.searchBoards",
        "title": "Search Boards",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.searchBoardsActive",
        "title": "Search Boards",
        "category": "Ticket Manager",
        "icon": {
          "light": "media/search-active-light.svg",
          "dark": "media/search-active-dark.svg"
        }
      },
      {
        "command": "ticketManager.configureBoardColumns",
        "title": "Configure Board Settings",
        "category": "Ticket Manager",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ticketManager.setBoardProjects",
        "title": "Set Board Projects",
        "category": "Ticket Manager",
        "icon": "$(repo)"
      },
      {
        "command": "ticketManager.setBoardTypes",
        "title": "Set Board Types",
        "category": "Ticket Manager",
        "icon": "$(list-tree)"
      },
      {
        "command": "ticketManager.setBoardSearchText",
        "title": "Set Board Search Text",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.clearBoardFilters",
        "title": "Clear Board Filters",
        "category": "Ticket Manager",
        "icon": "$(clear-all)"
      },
      {
        "command": "ticketManager.setProjects",
        "title": "Set Projects",
        "category": "Ticket Manager",
        "icon": "$(repo)"
      },
      {
        "command": "ticketManager.setStatuses",
        "title": "Set Status Filter",
        "category": "Ticket Manager",
        "icon": "$(list-selection)"
      },
      {
        "command": "ticketManager.setIssueTypes",
        "title": "Set Issue Type Filter",
        "category": "Ticket Manager",
        "icon": "$(symbol-class)"
      },
      {
        "command": "ticketManager.setSearchText",
        "title": "Set Search Text",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.toggleAssigneeMode",
        "title": "Toggle Assignee Scope",
        "category": "Ticket Manager",
        "icon": "$(account)"
      },
      {
        "command": "ticketManager.setParentScope",
        "title": "Set Parent Item Scope",
        "category": "Ticket Manager",
        "icon": "$(milestone)"
      },
      {
        "command": "ticketManager.clearParentScope",
        "title": "Clear Parent Item Scope",
        "category": "Ticket Manager",
        "icon": "$(close)"
      },
      {
        "command": "ticketManager.clearFilters",
        "title": "Clear Filters",
        "category": "Ticket Manager",
        "icon": "$(clear-all)"
      },
      {
        "command": "ticketManager.changeStatus",
        "title": "Change Status",
        "category": "Ticket Manager",
        "icon": "$(play-circle)"
      },
      {
        "command": "ticketManager.openIssueFullDetails",
        "title": "Open Full Issue Details",
        "category": "Ticket Manager",
        "icon": "$(preview)"
      },
      {
        "command": "ticketManager.openInBrowser",
        "title": "Open External Link",
        "category": "Ticket Manager",
        "icon": "$(link-external)"
      },
      {
        "command": "ticketManager.copyKey",
        "title": "Copy Issue Key",
        "category": "Ticket Manager",
        "icon": "$(copy)"
      },
      {
        "command": "ticketManager.loadMore",
        "title": "Load More",
        "category": "Ticket Manager",
        "icon": "$(chevron-down)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.epics",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.createEpic",
          "when": "view == ticketManager.epics",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.searchEpics",
          "when": "view == ticketManager.epics && !ticketManager.epicsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.searchEpicsActive",
          "when": "view == ticketManager.epics && ticketManager.epicsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.createIssue",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.searchIssues",
          "when": "view == ticketManager.myIssues && !ticketManager.issuesSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.searchIssuesActive",
          "when": "view == ticketManager.myIssues && ticketManager.issuesSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.setProjects",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.setParentScope",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@5"
        },
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.boards",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.createBoard",
          "when": "view == ticketManager.boards",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.createIssue",
          "when": "view == ticketManager.boards",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.searchBoards",
          "when": "view == ticketManager.boards && !ticketManager.boardsSearchActive",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.searchBoardsActive",
          "when": "view == ticketManager.boards && ticketManager.boardsSearchActive",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.setBoardProjects",
          "when": "view == ticketManager.boards",
          "group": "navigation@5"
        },
        {
          "command": "ticketManager.setBoardTypes",
          "when": "view == ticketManager.boards",
          "group": "navigation@6"
        },
        {
          "command": "ticketManager.configureBoardColumns",
          "when": "view == ticketManager.boards",
          "group": "navigation@7"
        },
        {
          "command": "ticketManager.clearBoardFilters",
          "when": "view == ticketManager.boards"
        },
        {
          "command": "ticketManager.setBackendMode",
          "when": "view == ticketManager.boards"
        },
        {
          "command": "ticketManager.configureConnection",
          "when": "view == ticketManager.myIssues && ticketManager.mode == jira"
        },
        {
          "command": "ticketManager.setBackendMode",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.checkConnection",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.importWorkspaceMcpConfig",
          "when": "view == ticketManager.myIssues && ticketManager.mode == jira"
        },
        {
          "command": "ticketManager.importUserMcpConfig",
          "when": "view == ticketManager.myIssues && ticketManager.mode == jira"
        },
        {
          "command": "ticketManager.setStatuses",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.setIssueTypes",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.toggleAssigneeMode",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.clearParentScope",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.clearFilters",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.changeStatus",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.openInBrowser",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.openIssueFullDetails",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "ticketManager.openInBrowser",
          "when": "view == ticketManager.myIssues && viewItem == issue",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.changeStatus",
          "when": "view == ticketManager.myIssues && viewItem == issue",
          "group": "inline@2"
        },
        {
          "command": "ticketManager.copyKey",
          "when": "view == ticketManager.myIssues && viewItem == issue",
          "group": "secondary"
        },
        {
          "command": "ticketManager.loadMore",
          "when": "view == ticketManager.myIssues && viewItem == loadMore",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.openBoard",
          "when": "view == ticketManager.boards && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.configureBoardColumns",
          "when": "view == ticketManager.boards && viewItem == board",
          "group": "inline@2"
        },
        {
          "command": "ticketManager.createIssue",
          "when": "view == ticketManager.boards && viewItem == board",
          "group": "inline@3"
        },
        {
          "command": "ticketManager.openIssueFullDetails",
          "when": "view == ticketManager.issueDetails && viewItem == issueKey",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ticketManager.searchIssuesActive",
          "when": "false"
        },
        {
          "command": "ticketManager.searchEpicsActive",
          "when": "false"
        },
        {
          "command": "ticketManager.searchBoardsActive",
          "when": "false"
        },
        {
          "command": "ticketManager.newProject",
          "when": "config.ticketManager.enableNewProject"
        }
      ]
    },
    "configuration": {
      "title": "Ticket Manager",
      "properties": {
        "ticketManager.connectionType": {
          "type": "string",
          "default": "stdio",
          "enum": [
            "stdio",
            "http"
          ],
          "enumItemLabels": [
            "Local Process (stdio)",
            "Remote MCP (HTTP)"
          ],
          "description": "Select how the app connects to the Jira MCP server when Jira Connected mode is active."
        },
        "ticketManager.backendMode": {
          "type": "string",
          "enum": [
            "jira",
            "demo",
            "file",
            "github",
            "gitlab"
          ],
          "enumItemLabels": [
            "Jira Connected",
            "Demo",
            "Plan File",
            "GitHub",
            "GitLab"
          ],
          "scope": "window",
          "description": "Choose whether the app uses Jira Connected, Demo, or File mode."
        },
        "ticketManager.planFilePath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Absolute or workspace-relative path to the plan file used in File mode."
        },
        "ticketManager.stdioCommand": {
          "type": "string",
          "default": "",
          "description": "Command used to start a local Jira MCP server."
        },
        "ticketManager.stdioArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the local Jira MCP command."
        },
        "ticketManager.stdioCwd": {
          "type": "string",
          "default": "",
          "description": "Optional working directory for the local Jira MCP command."
        },
        "ticketManager.httpUrl": {
          "type": "string",
          "default": "",
          "format": "uri",
          "description": "Base URL for a remote Jira MCP server that supports streamable HTTP."
        },
        "ticketManager.enableNewProject": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Enable the **New Project** wizard (preview). When disabled, the command is hidden from the Command Palette.",
          "tags": ["preview"]
        },
        "ticketManager.githubPat": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "GitHub Personal Access Token for authenticating with the GitHub API."
        },
        "ticketManager.githubUrl": {
          "type": "string",
          "default": "https://api.github.com",
          "format": "uri",
          "scope": "window",
          "description": "GitHub API base URL. Use the default for github.com or set to your GitHub Enterprise Server URL (e.g. https://github.example.com/api/v3)."
        },
        "ticketManager.githubOwner": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "GitHub organisation or user that owns the repositories to manage."
        },
        "ticketManager.gitlabUrl": {
          "type": "string",
          "default": "",
          "format": "uri",
          "scope": "window",
          "description": "GitLab instance URL (e.g. https://gitlab.com or https://gitlab.example.com)."
        },
        "ticketManager.gitlabConnectionType": {
          "type": "string",
          "default": "api",
          "enum": ["api", "mcp"],
          "enumItemLabels": ["API Key", "GitLab MCP Server"],
          "scope": "window",
          "description": "How to connect to GitLab: direct API key or through a GitLab MCP server."
        },
        "ticketManager.gitlabApiKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "GitLab Personal Access Token for direct API access."
        },
        "ticketManager.gitlabMcpCommand": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Command to start the GitLab MCP server (when using MCP connection type)."
        },
        "ticketManager.gitlabMcpArgs": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "scope": "window",
          "description": "Arguments for the GitLab MCP server command."
        },
        "ticketManager.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Timeout, in milliseconds, for MCP requests."
        },
        "ticketManager.defaultPageSize": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 100,
          "description": "Number of issues to request per page."
        },
        "ticketManager.workspaceMcpServerName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional workspace MCP server name to use from .vscode/mcp.json when Jira Connected mode is not manually configured."
        },
        "ticketManager.userMcpServerRef": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional user/profile MCP server reference to use when Jira Connected mode is not manually configured and no workspace MCP server is selected."
        },
        "ticketManager.jiraBoardListIconColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Accent color for the small backend icon to the left of each board name in the Boards list when **Jira Connected** mode is active. Use hex (e.g. `#3b82f6`). Leave empty for the built-in default."
        },
        "ticketManager.demoBoardListIconColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Accent color for the small backend icon beside board names when **Demo** mode is active. Use hex (e.g. `#a855f7`). Leave empty for the built-in default."
        },
        "ticketManager.fileBoardListIconColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Accent color for the small backend icon beside board names when **File** mode is active. Use hex (e.g. `#22c55e`). Leave empty for the built-in default."
        }
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.1.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/vscode": "1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2"
  }
}
