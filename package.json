{
  "name": "praxis-workspace",
  "description": "Monorepo for the Praxis desktop app, over a shared core.",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/praxis-desktop/main",
    "apps/praxis-desktop/renderer",
    "apps/praxis-mobile",
    "packages/*"
  ],
  "scripts": {
    "check-types": "npm run check-types --workspaces --if-present",
    "build": "npm run build:core && npm run build:mobile-protocol && npm run build:renderer && npm run desktop:copy-renderer && npm run build:desktop",
    "test": "npm run test:core && npm run test:mobile-protocol && npm run test:mobile && npm run test:desktop:git && npm run test:desktop:workflows && npm run test:desktop:mobile && npm run test:desktop && npm run test:desktop:themes",
    "build:core": "npm run compile --workspace=@praxis/core",
    "test:core": "npm test --workspace=@praxis/core",
    "build:mobile-protocol": "npm run compile --workspace=@praxis/mobile-protocol",
    "test:mobile-protocol": "npm test --workspace=@praxis/mobile-protocol",
    "build:mobile": "npm run compile --workspace=@praxis/mobile",
    "test:mobile": "npm test --workspace=@praxis/mobile",
    "mobile:fixture": "npm run fixture --workspace=@praxis/mobile",
    "renderer:dev": "npm run dev --workspace=@praxis/desktop-renderer",
    "build:renderer": "npm run build --workspace=@praxis/desktop-renderer",
    "renderer:textures": "npm run textures --workspace=@praxis/desktop-renderer",
    "desktop:start": "npm run start --workspace=@praxis/desktop-main",
    "desktop:copy-renderer": "npm run copy-renderer --workspace=@praxis/desktop-main",
    "build:desktop": "npm run compile --workspace=@praxis/desktop-main",
    "test:desktop": "npm run test:e2e --workspace=@praxis/desktop-main -- --project=functional",
    "test:desktop:themes": "npm run test:e2e --workspace=@praxis/desktop-main -- --project=themes --project=theme-regressions",
    "test:desktop:all": "npm run test:e2e --workspace=@praxis/desktop-main -- --project=functional --project=themes --project=theme-regressions",
    "reset:workspace-data": "node scripts/reset-praxis-workspace-data.mjs",
    "test:desktop:workflows": "npm run test:workflows --workspace=@praxis/desktop-main",
    "test:desktop:git": "npm run test:git --workspace=@praxis/desktop-main",
    "test:desktop:mobile": "npm run test:mobile --workspace=@praxis/desktop-main",
    "desktop:dist": "npm run dist --workspace=@praxis/desktop-main",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-app.ps1",
    "app:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-app.ps1 -Demo",
    "app:demo:mac": "./scripts/run-app.sh --demo",
    "app:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-app.ps1 -Dev",
    "app:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-app.ps1",
    "app:build:mac": "./scripts/build-app.sh",
    "app:build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-app.ps1",
    "app:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-installer.ps1",
    "app:installer:mac": "./scripts/build-installer.sh --target mac",
    "app:installer:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-installer.ps1 -Target nsis",
    "app:installer:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-installer.ps1 -Target portable",
    "app:installer:dir": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-installer.ps1 -Target dir",
    "app:dist": "npm run app:installer",
    "app:dist:mac": "npm run app:installer:mac",
    "app:dist:win": "npm run app:installer:win",
    "app:dist:portable": "npm run app:installer:portable",
    "app:dist:dir": "npm run app:installer:dir",
    "publish:packages": "npm publish --workspace=@praxis/core --workspace=@praxis/mobile-protocol",
    "release:create": "node scripts/create-release.mjs"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5",
    "qs": "^6.16.0",
    "fast-uri": "^3.1.6",
    "@xmldom/xmldom": "^0.8.15",
    "uuid": "^11.1.1",
    "js-yaml": "^4.3.2",
    "hono": "^4.13.5"
  },
  "//optionalDependencies": "vite 8 bundles with rolldown and minifies CSS with lightningcss — both load a native binding. npm prunes the non-host platform bindings of TRANSITIVE optional deps from a lockfile generated on one OS (npm/cli#4828), so a lockfile regenerated on macOS left `npm ci` on the Linux CI runner with no binding to load and `vite build` crashed with 'Cannot find native binding'. Declaring the bindings here as direct optional deps forces every listed platform into package-lock.json regardless of the OS the lockfile is regenerated on; npm still skips installing the ones that do not match the host. Keep these versions matched to the resolved `rolldown` / `lightningcss` in the lockfile — a mismatch fails `npm ci` loudly instead of silently.",
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.5",
    "@rolldown/binding-linux-arm64-gnu": "1.2.5",
    "@rolldown/binding-darwin-arm64": "1.2.5",
    "@rolldown/binding-darwin-x64": "1.2.5",
    "@rolldown/binding-win32-x64-msvc": "1.2.5",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-arm64-gnu": "1.33.0",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-darwin-x64": "1.33.0",
    "lightningcss-win32-x64-msvc": "1.33.0"
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild": true,
    "electron-builder": true,
    "electron-winstaller": false
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "babel-preset-expo": "~57.0.11",
    "@babel/core": "^7.25.0"
  }
}
