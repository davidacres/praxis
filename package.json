{
  "name": "praxis-workspace",
  "description": "Monorepo for the Praxis desktop app and the Ticket Manager VS Code extension, over a shared core.",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/praxis-desktop/main",
    "apps/praxis-desktop/renderer",
    "apps/vscode-extension",
    "packages/*"
  ],
  "scripts": {
    "check-types": "npm run check-types --workspaces --if-present",
    "build": "npm run build:core && npm run build:renderer && npm run desktop:copy-renderer && npm run build:desktop && npm run build:vscode",
    "test": "npm run test:core && npm run test:desktop && npm run test:vscode",
    "clean": "npm run clean --workspace=ticket-manager",

    "build:core": "npm run compile --workspace=@praxis/core",
    "test:core": "npm test --workspace=@praxis/core",

    "renderer:dev": "npm run dev --workspace=@praxis/desktop-renderer",
    "build:renderer": "npm run build --workspace=@praxis/desktop-renderer",
    "renderer:textures": "npm run textures --workspace=@praxis/desktop-renderer",

    "desktop:start": "npm run start --workspace=@praxis/desktop-main",
    "desktop:copy-renderer": "npm run copy-renderer --workspace=@praxis/desktop-main",
    "build:desktop": "npm run compile --workspace=@praxis/desktop-main",
    "test:desktop": "npm run test:e2e --workspace=@praxis/desktop-main",
    "test:desktop:git": "npm run test:git --workspace=@praxis/desktop-main",
    "desktop:dist": "npm run dist --workspace=@praxis/desktop-main",

    "build:vscode": "npm run compile --workspace=ticket-manager",
    "test:vscode": "npm test --workspace=ticket-manager",
    "package:vscode": "npm run package --workspace=ticket-manager",
    "watch:vscode": "npm run watch --workspace=ticket-manager",
    "vscode:prepublish": "npm run vscode:prepublish --workspace=ticket-manager",
    "vscode:install:all": "npm run install:all --workspace=ticket-manager",
    "vscode:uninstall:all": "npm run uninstall:all --workspace=ticket-manager",
    "vscode:build:install": "npm run build:install --workspace=ticket-manager",
    "vscode:publish:gitlab": "npm run publish:gitlab --workspace=ticket-manager",
    "vscode:publish:github": "npm run publish:github --workspace=ticket-manager",
    "vscode:install:from-gitlab": "npm run install:from-gitlab --workspace=ticket-manager",
    "vscode:install:vsix": "npm run install:vsix --workspace=ticket-manager",
    "vscode:install:code": "npm run install:code --workspace=ticket-manager",
    "vscode:install:insiders": "npm run install:insiders --workspace=ticket-manager",
    "vscode:install:cursor": "npm run install:cursor --workspace=ticket-manager",
    "vscode:open": "npm run open:ticket-manager --workspace=ticket-manager",
    "docs:commands": "npm run docs:commands --workspace=ticket-manager",
    "bedrock:glm-test": "npm run bedrock:glm-test --workspace=ticket-manager",
    "bedrock:proxy": "npm run bedrock:proxy --workspace=ticket-manager",
    "jira-mr-polling": "npm run jira-mr-polling --workspace=ticket-manager",
    "jira-mr-polling:once": "npm run jira-mr-polling:once --workspace=ticket-manager",
    "jira-mr-polling:test": "npm run jira-mr-polling:test --workspace=ticket-manager",

    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-app.ps1",
    "app:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-app.ps1 -Dev",
    "app:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-app.ps1",
    "app:dist:mac": "./scripts/build-app.sh --target mac",
    "app:dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-app.ps1 -Target nsis",
    "app:dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-app.ps1 -Target portable",
    "app:dist:dir": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-app.ps1 -Target dir"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5"
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild": true,
    "electron-builder": true,
    "electron-winstaller": false
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
