{
  "name": "ticket-manager",
  "displayName": "Ticket Manager",
  "version": "0.0.1",
  "publisher": "local-dev",
  "description": "A compact issue and board sidebar for VS Code with connected, demo, and file-backed modes.",
  "license": "MIT",
  "preview": true,
  "pricing": "Free",
  "type": "commonjs",
  "main": "./out/extension.js",
  "icon": "media/marketplace-icon.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "issues",
    "tickets",
    "boards",
    "mcp",
    "activity-bar",
    "sidebar"
  ],
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "clean": "rimraf out",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch -p ./",
    "package": "npm run check-types && node esbuild.mjs --production",
    "check-types": "tsc --noEmit -p ./",
    "test": "vscode-test --label integration",
    "install:vsix": "node ./scripts/install-vsix.cjs",
    "install:code": "powershell -ExecutionPolicy Bypass -File ./scripts/install-vscode.ps1",
    "install:insiders": "powershell -ExecutionPolicy Bypass -File ./scripts/install-vscode-insiders.ps1",
    "install:cursor": "powershell -ExecutionPolicy Bypass -File ./scripts/install-cursor-extension.ps1"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ticketManager",
          "title": "Tickets",
          "icon": "media/activitybar-ticket.svg"
        }
      ]
    },
    "views": {
      "ticketManager": [
        {
          "id": "ticketManager.setup",
          "name": "Configure Project",
          "type": "webview",
          "when": "!ticketManager.configured"
        },
        {
          "id": "ticketManager.boards",
          "name": "Boards",
          "type": "webview",
          "when": "ticketManager.configured"
        },
        {
          "id": "ticketManager.epics",
          "name": "EPICs",
          "type": "webview",
          "when": "ticketManager.configured"
        },
        {
          "id": "ticketManager.myIssues",
          "name": "My Issues",
          "type": "webview",
          "when": "ticketManager.configured"
        },
        {
          "id": "ticketManager.activeSessions",
          "name": "Active Sessions",
          "type": "webview",
          "when": "ticketManager.configured"
        },
        {
          "id": "ticketManager.issueDetails",
          "name": "Issue Details",
          "type": "webview",
          "when": "ticketManager.configured"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ticketManager.myIssues",
        "contents": "Welcome to Ticket Manager!\\nConfigure a project to get started.\\n[$(gear) Configure Project](command:ticketManager.openSetup)\\n\\nAlready configured? [Set Backend Mode](command:ticketManager.setBackendMode)"
      },
      {
        "view": "ticketManager.activeSessions",
        "contents": "Assigned AI work and live agent runs appear here. Double-click a session to open the full session details tab."
      },
      {
        "view": "ticketManager.issueDetails",
        "contents": "Select an issue in **My Issues** or on a board to inspect its details and transitions."
      },
      {
        "view": "ticketManager.epics",
        "contents": "Browse and manage EPICs for the current project scope."
      },
      {
        "view": "ticketManager.boards",
        "contents": "Browse boards and open a board tab.\\n[Set Board Search](command:ticketManager.setBoardSearchText)\\n[Set Board Projects](command:ticketManager.setBoardProjects)\\n[Set Board Types](command:ticketManager.setBoardTypes)"
      }
    ],
    "commands": [
      {
        "command": "ticketManager.refresh",
        "title": "Refresh",
        "category": "Ticket Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "ticketManager.configureConnection",
        "title": "Configure Connection",
        "category": "Ticket Manager",
        "icon": "$(plug)"
      },
      {
        "command": "ticketManager.checkConnection",
        "title": "Check Connection",
        "category": "Ticket Manager",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ticketManager.setBackendMode",
        "title": "Set Backend Mode",
        "category": "Ticket Manager",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "ticketManager.openSetup",
        "title": "Configure Project",
        "category": "Ticket Manager",
        "icon": "$(gear)"
      },
      {
        "command": "ticketManager.openSettings",
        "title": "Open Settings",
        "category": "Ticket Manager",
        "icon": "$(gear)"
      },
      {
        "command": "ticketManager.configureAi",
        "title": "Configure AI",
        "category": "Ticket Manager",
        "icon": "$(hubot)"
      },
      {
        "command": "ticketManager.delegateToCopilot",
        "title": "Delegate to Copilot Agent",
        "category": "Ticket Manager",
        "icon": "$(hubot)"
      },
      {
        "command": "ticketManager.viewAgentSession",
        "title": "View AI Session",
        "category": "Ticket Manager",
        "icon": "$(eye)"
      },
      {
        "command": "ticketManager.abortAgentSession",
        "title": "Abort Agent Session",
        "category": "Ticket Manager",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ticketManager.importMarkdownFeaturePlan",
        "title": "Import Plan from Markdown Features",
        "category": "Ticket Manager",
        "icon": "$(file-code)"
      },
      {
        "command": "ticketManager.newProject",
        "title": "New Project",
        "category": "Ticket Manager",
        "icon": "$(rocket)"
      },
      {
        "command": "ticketManager.importWorkspaceMcpConfig",
        "title": "Use Workspace MCP Configuration",
        "category": "Ticket Manager",
        "icon": "$(folder-library)"
      },
      {
        "command": "ticketManager.importUserMcpConfig",
        "title": "Use User/Profile MCP Configuration",
        "category": "Ticket Manager",
        "icon": "$(account)"
      },
      {
        "command": "ticketManager.openBoard",
        "title": "Open Board",
        "category": "Ticket Manager",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ticketManager.createIssue",
        "title": "Create Issue",
        "category": "Ticket Manager",
        "icon": "$(add)"
      },
      {
        "command": "ticketManager.createBoard",
        "title": "Create Board",
        "category": "Ticket Manager",
        "icon": "$(new-folder)"
      },
      {
        "command": "ticketManager.createEpic",
        "title": "Create EPIC",
        "category": "Ticket Manager",
        "icon": "$(add)"
      },
      {
        "command": "ticketManager.searchIssues",
        "title": "Search Issues",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.searchIssuesActive",
        "title": "Search Issues",
        "category": "Ticket Manager",
        "icon": {
          "light": "media/search-active-light.svg",
          "dark": "media/search-active-dark.svg"
        }
      },
      {
        "command": "ticketManager.searchEpics",
        "title": "Search EPICs",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.searchEpicsActive",
        "title": "Search EPICs",
        "category": "Ticket Manager",
        "icon": {
          "light": "media/search-active-light.svg",
          "dark": "media/search-active-dark.svg"
        }
      },
      {
        "command": "ticketManager.searchBoards",
        "title": "Search Boards",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.searchBoardsActive",
        "title": "Search Boards",
        "category": "Ticket Manager",
        "icon": {
          "light": "media/search-active-light.svg",
          "dark": "media/search-active-dark.svg"
        }
      },
      {
        "command": "ticketManager.configureBoardColumns",
        "title": "Configure Board Settings",
        "category": "Ticket Manager",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ticketManager.setBoardProjects",
        "title": "Set Board Projects",
        "category": "Ticket Manager",
        "icon": "$(repo)"
      },
      {
        "command": "ticketManager.setBoardTypes",
        "title": "Set Board Types",
        "category": "Ticket Manager",
        "icon": "$(list-tree)"
      },
      {
        "command": "ticketManager.setBoardSearchText",
        "title": "Set Board Search Text",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.clearBoardFilters",
        "title": "Clear Board Filters",
        "category": "Ticket Manager",
        "icon": "$(clear-all)"
      },
      {
        "command": "ticketManager.setProjects",
        "title": "Set Projects",
        "category": "Ticket Manager",
        "icon": "$(repo)"
      },
      {
        "command": "ticketManager.setStatuses",
        "title": "Set Status Filter",
        "category": "Ticket Manager",
        "icon": "$(list-selection)"
      },
      {
        "command": "ticketManager.setIssueTypes",
        "title": "Set Issue Type Filter",
        "category": "Ticket Manager",
        "icon": "$(symbol-class)"
      },
      {
        "command": "ticketManager.setSearchText",
        "title": "Set Search Text",
        "category": "Ticket Manager",
        "icon": "$(search)"
      },
      {
        "command": "ticketManager.toggleAssigneeMode",
        "title": "Toggle Assignee Scope",
        "category": "Ticket Manager",
        "icon": "$(account)"
      },
      {
        "command": "ticketManager.setParentScope",
        "title": "Set Parent Item Scope",
        "category": "Ticket Manager",
        "icon": "$(milestone)"
      },
      {
        "command": "ticketManager.clearParentScope",
        "title": "Clear Parent Item Scope",
        "category": "Ticket Manager",
        "icon": "$(close)"
      },
      {
        "command": "ticketManager.clearFilters",
        "title": "Clear Filters",
        "category": "Ticket Manager",
        "icon": "$(clear-all)"
      },
      {
        "command": "ticketManager.changeStatus",
        "title": "Change Status",
        "category": "Ticket Manager",
        "icon": "$(play-circle)"
      },
      {
        "command": "ticketManager.openIssueFullDetails",
        "title": "Open Full Issue Details",
        "category": "Ticket Manager",
        "icon": "$(preview)"
      },
      {
        "command": "ticketManager.openInBrowser",
        "title": "Open External Link",
        "category": "Ticket Manager",
        "icon": "$(link-external)"
      },
      {
        "command": "ticketManager.copyKey",
        "title": "Copy Issue Key",
        "category": "Ticket Manager",
        "icon": "$(copy)"
      },
      {
        "command": "ticketManager.loadMore",
        "title": "Load More",
        "category": "Ticket Manager",
        "icon": "$(chevron-down)"
      },
      {
        "command": "ticketManager.assignToMe",
        "title": "Assign to Me",
        "category": "Ticket Manager",
        "icon": "$(person)"
      },
      {
        "command": "ticketManager.assignToAi",
        "title": "Assign to AI Agent",
        "category": "Ticket Manager",
        "icon": "$(hubot)"
      },
      {
        "command": "ticketManager.unassignAi",
        "title": "Abandon AI Session",
        "category": "Ticket Manager",
        "icon": "$(close)"
      },
      {
        "command": "ticketManager.reviewWithAi",
        "title": "Review Ticket with AI",
        "category": "Ticket Manager",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ticketManager.localPeerReview",
        "title": "Local Peer Review (LPR)",
        "category": "Ticket Manager",
        "icon": "$(checklist)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.epics",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.createEpic",
          "when": "view == ticketManager.epics",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.searchEpics",
          "when": "view == ticketManager.epics && !ticketManager.epicsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.searchEpicsActive",
          "when": "view == ticketManager.epics && ticketManager.epicsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.createIssue",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.searchIssues",
          "when": "view == ticketManager.myIssues && !ticketManager.issuesSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.searchIssuesActive",
          "when": "view == ticketManager.myIssues && ticketManager.issuesSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.setProjects",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.setParentScope",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@5"
        },
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.boards",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.createBoard",
          "when": "view == ticketManager.boards",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.createIssue",
          "when": "view == ticketManager.boards",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.searchBoards",
          "when": "view == ticketManager.boards && !ticketManager.boardsSearchActive",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.searchBoardsActive",
          "when": "view == ticketManager.boards && ticketManager.boardsSearchActive",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.setBoardProjects",
          "when": "view == ticketManager.boards",
          "group": "navigation@5"
        },
        {
          "command": "ticketManager.setBoardTypes",
          "when": "view == ticketManager.boards",
          "group": "navigation@6"
        },
        {
          "command": "ticketManager.configureBoardColumns",
          "when": "view == ticketManager.boards",
          "group": "navigation@7"
        },
        {
          "command": "ticketManager.clearBoardFilters",
          "when": "view == ticketManager.boards"
        },
        {
          "command": "ticketManager.setBackendMode",
          "when": "view == ticketManager.boards"
        },
        {
          "command": "ticketManager.configureConnection",
          "when": "view == ticketManager.myIssues && ticketManager.mode == jira"
        },
        {
          "command": "ticketManager.setBackendMode",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.checkConnection",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.importWorkspaceMcpConfig",
          "when": "view == ticketManager.myIssues && ticketManager.mode == jira"
        },
        {
          "command": "ticketManager.importUserMcpConfig",
          "when": "view == ticketManager.myIssues && ticketManager.mode == jira"
        },
        {
          "command": "ticketManager.setStatuses",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.setIssueTypes",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.toggleAssigneeMode",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.clearParentScope",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.clearFilters",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.activeSessions",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.changeStatus",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.openInBrowser",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.openIssueFullDetails",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.assignToAi",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.unassignAi",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "ticketManager.openInBrowser",
          "when": "view == ticketManager.myIssues && viewItem == issue",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.changeStatus",
          "when": "view == ticketManager.myIssues && viewItem == issue",
          "group": "inline@2"
        },
        {
          "command": "ticketManager.copyKey",
          "when": "view == ticketManager.myIssues && viewItem == issue",
          "group": "secondary"
        },
        {
          "command": "ticketManager.loadMore",
          "when": "view == ticketManager.myIssues && viewItem == loadMore",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.openBoard",
          "when": "view == ticketManager.boards && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.configureBoardColumns",
          "when": "view == ticketManager.boards && viewItem == board",
          "group": "inline@2"
        },
        {
          "command": "ticketManager.createIssue",
          "when": "view == ticketManager.boards && viewItem == board",
          "group": "inline@3"
        },
        {
          "command": "ticketManager.openIssueFullDetails",
          "when": "view == ticketManager.issueDetails && viewItem == issueKey",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ticketManager.searchIssuesActive",
          "when": "false"
        },
        {
          "command": "ticketManager.searchEpicsActive",
          "when": "false"
        },
        {
          "command": "ticketManager.searchBoardsActive",
          "when": "false"
        },
        {
          "command": "ticketManager.newProject",
          "when": "config.ticketManager.enableNewProject"
        }
      ]
    },
    "configuration": {
      "title": "Ticket Manager",
      "properties": {
        "ticketManager.connectionType": {
          "type": "string",
          "default": "stdio",
          "enum": [
            "stdio",
            "http"
          ],
          "enumItemLabels": [
            "Local Process (stdio)",
            "Remote MCP (HTTP)"
          ],
          "description": "Select how the app connects to the Jira MCP server when Jira Connected mode is active."
        },
        "ticketManager.backendMode": {
          "type": "string",
          "enum": [
            "jira",
            "demo",
            "file",
            "github",
            "gitlab",
            "livefolder",
            "userworkspace"
          ],
          "enumItemLabels": [
            "Jira Connected",
            "Demo",
            "Plan File",
            "GitHub",
            "GitLab",
            "Live Folder",
            "User Workspace"
          ],
          "scope": "window",
          "description": "Choose whether the app uses Jira Connected, Demo, File, Live Folder, or User Workspace mode."
        },
        "ticketManager.planFilePath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Absolute or workspace-relative path to the plan file used in File mode."
        },
        "ticketManager.stdioCommand": {
          "type": "string",
          "default": "",
          "description": "Command used to start a local Jira MCP server."
        },
        "ticketManager.stdioArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the local Jira MCP command."
        },
        "ticketManager.stdioCwd": {
          "type": "string",
          "default": "",
          "description": "Optional working directory for the local Jira MCP command."
        },
        "ticketManager.httpUrl": {
          "type": "string",
          "default": "",
          "format": "uri",
          "description": "Base URL for a remote Jira MCP server that supports streamable HTTP."
        },
        "ticketManager.enableNewProject": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Enable the **New Project** wizard (preview). When disabled, the command is hidden from the Command Palette.",
          "tags": [
            "preview"
          ]
        },
        "ticketManager.githubPat": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "GitHub Personal Access Token for authenticating with the GitHub API."
        },
        "ticketManager.githubUrl": {
          "type": "string",
          "default": "https://api.github.com",
          "format": "uri",
          "scope": "window",
          "description": "GitHub API base URL. Use the default for github.com or set to your GitHub Enterprise Server URL (e.g. https://github.example.com/api/v3)."
        },
        "ticketManager.githubOwner": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "GitHub organisation or user that owns the repositories to manage."
        },
        "ticketManager.gitlabUrl": {
          "type": "string",
          "default": "",
          "format": "uri",
          "scope": "window",
          "description": "GitLab instance URL (e.g. https://gitlab.com or https://gitlab.example.com)."
        },
        "ticketManager.gitlabConnectionType": {
          "type": "string",
          "default": "api",
          "enum": [
            "api",
            "mcp"
          ],
          "enumItemLabels": [
            "API Key",
            "GitLab MCP Server"
          ],
          "scope": "window",
          "description": "How to connect to GitLab: direct API key or through a GitLab MCP server."
        },
        "ticketManager.gitlabApiKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "GitLab Personal Access Token for direct API access."
        },
        "ticketManager.gitlabMcpCommand": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Command to start the GitLab MCP server (when using MCP connection type)."
        },
        "ticketManager.gitlabMcpArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "scope": "window",
          "description": "Arguments for the GitLab MCP server command."
        },
        "ticketManager.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Timeout, in milliseconds, for MCP requests."
        },
        "ticketManager.defaultPageSize": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 100,
          "description": "Number of issues to request per page."
        },
        "ticketManager.workspaceMcpServerName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional workspace MCP server name to use from .vscode/mcp.json when Jira Connected mode is not manually configured."
        },
        "ticketManager.userMcpServerRef": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional user/profile MCP server reference to use when Jira Connected mode is not manually configured and no workspace MCP server is selected."
        },
        "ticketManager.jiraBoardListIconColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Accent color for the small backend icon to the left of each board name in the Boards list when **Jira Connected** mode is active. Use hex (e.g. `#3b82f6`). Leave empty for the built-in default."
        },
        "ticketManager.demoBoardListIconColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Accent color for the small backend icon beside board names when **Demo** mode is active. Use hex (e.g. `#a855f7`). Leave empty for the built-in default."
        },
        "ticketManager.fileBoardListIconColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Accent color for the small backend icon beside board names when **File** mode is active. Use hex (e.g. `#22c55e`). Leave empty for the built-in default."
        },
        "ticketManager.liveFolderPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a `plans` folder, `features` folder, or parent folder to search for `features/feature-NN-*/feature.md` and `story-*.md` files. Used when **Live Folder** mode is active."
        },
        "ticketManager.liveFolderProjectKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Project key for issues derived from the live folder (e.g. `EXAMPLE`). Used when **Live Folder** mode is active."
        },
        "ticketManager.liveFolderProjectName": {
          "type": "string",
          "default": "",
          "markdownDescription": "Human-readable project name for the live folder (e.g. `ExampleHIS Integration`). Used when **Live Folder** mode is active."
        },
        "ticketManager.liveFolderAllowIssueCreation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Allow Ticket Manager to create new markdown issue files when **Live Folder** mode is active. Disable this to keep the live folder read-only from the extension."
        },
        "ticketManager.liveFolderBoardListIconColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Accent color for the small backend icon beside board names when **Live Folder** mode is active. Use hex (e.g. `#f59e0b`). Leave empty for the built-in default."
        },
        "ticketManager.ai.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for AI agent assignment."
        },
        "ticketManager.ai.claudeApiKey": {
          "type": "string",
          "default": "",
          "description": "Claude/Anthropic API key for AI agent assignment."
        },
        "ticketManager.ai.cursorCliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Cursor CLI executable for AI agent assignment."
        },
        "ticketManager.ai.copilotEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the GitHub Copilot SDK for AI reviews, in-app @copilot comment replies, and Copilot agent tasks."
        },
        "ticketManager.ai.copilotCliPath": {
          "type": "string",
          "default": "",
          "description": "Legacy compatibility override for the runtime used by the GitHub Copilot SDK. Leave empty unless you are debugging a local Copilot SDK installation."
        },
        "ticketManager.ai.defaultProvider": {
          "type": "string",
          "default": "none",
          "enum": [
            "openai",
            "claude",
            "cursor-cli",
            "copilot-cli",
            "none"
          ],
          "enumDescriptions": [
            "Use OpenAI as the default AI provider.",
            "Use Claude/Anthropic as the default AI provider.",
            "Use Cursor CLI as the default AI provider.",
            "Use the GitHub Copilot SDK as the default AI provider.",
            "No default AI provider."
          ],
          "description": "Default AI provider to use when assigning tickets to an AI agent."
        },
        "ticketManager.ai.openaiAgentName": {
          "type": "string",
          "default": "",
          "description": "Display name for the OpenAI agent (e.g. 'GPT-4 Reviewer'). When set, this name appears as an assignee option and is used when assigning tickets to the OpenAI agent."
        },
        "ticketManager.ai.claudeAgentName": {
          "type": "string",
          "default": "",
          "description": "Display name for the Claude agent (e.g. 'Claude AI'). When set, this name appears as an assignee option and is used when assigning tickets to the Claude agent."
        },
        "ticketManager.ai.mentionName": {
          "type": "string",
          "default": "",
          "description": "Custom @mention name for triggering AI responses in comments (e.g. 'daveai'). When set, both @copilot and @<name> will trigger an AI reply. Leave blank to only respond to @copilot."
        },
        "ticketManager.ai.verboseActivityFeed": {
          "type": "boolean",
          "default": false,
          "description": "Show all event types (tool calls, permission requests, etc.) in the AI session activity feed. When disabled, only high-value events like messages, plans, and errors are shown."
        }
      }
    }
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.1.1"
  },
