# Dependencies
node_modules/

# TypeScript build output (extension entry: out/extension.js)
out/
dist/
# Renderer staging area: apps/praxis-desktop/renderer/dist is copied here by the
# electron-builder pipeline (see apps/praxis-desktop/main/scripts/copy-renderer.cjs)
# so the packaged app can load the renderer via a relative path inside the asar.
apps/praxis-desktop/main/renderer/
*.tsbuildinfo

# Packaged extension
*.vsix
artifacts/

# VS Code extension test runner (downloaded VS Code + user data)
.vscode-test/

# Per-machine editor settings. This file once carried GitLab tokens (see PRX-F107);
# credentials belong in the app's secret store, never in a tracked file.
.vscode/settings.json

# Captured provider traffic (request headers carry credentials).
*-capture.json

# Local scratch dir used by ad-hoc extension test runs
.praxis-test/

# Local development scratch files (debug runs, installed-editor lister,
# ad-hoc shell outputs from reproducing an issue). Never commit these.
loc.txt
test-output.txt
test-failures.txt
test-*.txt

# Ad-hoc screenshot/debug captures from local desktop/titlebar testing
/current.png
/screenshot.png
/titlebar*.png
/ascii-preview.ps1
/row-preview.ps1

# Test coverage
coverage/
.nyc_output/
*.lcov

# Logs and debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets (keep *.example committed if you add templates)
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

.playwright-mcp/

.tmp/

# Claude Code local user state (per-user, never commit)
.claude/settings.local.json

# Local agent worktrees (separate repositories, never commit to Praxis)
.worktrees/

# Playwright run artefacts (regenerated on every `playwright test`)
test-results/
playwright-report/
apps/praxis-desktop/main/output/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

