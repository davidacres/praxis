    "menus": {
      "view/title": [
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.epics",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.createEpic",
          "when": "view == ticketManager.epics",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.searchEpics",
          "when": "view == ticketManager.epics && !ticketManager.epicsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.searchEpicsActive",
          "when": "view == ticketManager.epics && ticketManager.epicsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.createIssue",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.createIdea",
          "when": "view == ticketManager.myIssues && config.ticketManager.enableCreateIdea",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.searchIssues",
          "when": "view == ticketManager.myIssues && !ticketManager.issuesSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.searchIssuesActive",
          "when": "view == ticketManager.myIssues && ticketManager.issuesSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.setProjects",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.setParentScope",
          "when": "view == ticketManager.myIssues",
          "group": "navigation@5"
        },
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.boards",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.createBoard",
          "when": "view == ticketManager.boards",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.searchBoards",
          "when": "view == ticketManager.boards && !ticketManager.boardsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.searchBoardsActive",
          "when": "view == ticketManager.boards && ticketManager.boardsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.setBoardProjects",
          "when": "view == ticketManager.boards",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.setBoardTypes",
          "when": "view == ticketManager.boards",
          "group": "navigation@5"
        },
        {
          "command": "ticketManager.openConnectionsManager",
          "when": "view == ticketManager.boards",
          "group": "navigation@6"
        },
        {
          "command": "ticketManager.clearBoardFilters",
          "when": "view == ticketManager.boards"
        },
        {
          "command": "ticketManager.setBackendMode",
          "when": "view == ticketManager.boards"
        },
        {
          "command": "ticketManager.toggleWorkMode",
          "when": "view == ticketManager.boards",
          "group": "navigation@8"
        },
        {
          "command": "ticketManager.configureConnection",
          "when": "view == ticketManager.myIssues && ticketManager.mode == jira"
        },
        {
          "command": "ticketManager.setBackendMode",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.checkConnection",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.setStatuses",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.setIssueTypes",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.toggleAssigneeMode",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.clearParentScope",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.clearFilters",
          "when": "view == ticketManager.myIssues"
        },
        {
          "command": "ticketManager.refresh",
          "when": "view == ticketManager.activeSessions",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.changeStatus",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@1"
        },
        {
          "command": "ticketManager.openInBrowser",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@2"
        },
        {
          "command": "ticketManager.openIssueFullDetails",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@3"
        },
        {
          "command": "ticketManager.assignToAi",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@4"
        },
        {
          "command": "ticketManager.openAnalysisWindow",
          "when": "view == ticketManager.issueDetails && ticketManager.analysisGateEnabled",
          "group": "navigation@4.5"
        },
        {
          "command": "ticketManager.assignWorkflowPack",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@5"
        },
        {
          "command": "ticketManager.unassignAi",
          "when": "view == ticketManager.issueDetails",
          "group": "navigation@6"
        },
        {
          "command": "ticketManager.toggleWorkMode",
          "when": "view == ticketManager.workModeBoards",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ticketManager.openInBrowser",
          "when": "view == ticketManager.myIssues && viewItem == issue",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.changeStatus",
          "when": "view == ticketManager.myIssues && viewItem == issue",
          "group": "inline@2"
        },
        {
          "command": "ticketManager.copyKey",
          "when": "view == ticketManager.myIssues && viewItem == issue",
          "group": "secondary"
        },
        {
          "command": "ticketManager.loadMore",
          "when": "view == ticketManager.myIssues && viewItem == loadMore",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.openBoard",
          "when": "view == ticketManager.boards && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.configureBoardColumns",
          "when": "view == ticketManager.boards && viewItem == board",
          "group": "inline@2"
        },
        {
          "command": "ticketManager.configureBoardColumns",
          "when": "view == ticketManager.workModeBoards && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.createIssue",
          "when": "view == ticketManager.boards && viewItem == board",
          "group": "inline@3"
        },
        {
          "command": "ticketManager.openIssueFullDetails",
          "when": "view == ticketManager.issueDetails && viewItem == issueKey",
          "group": "inline@1"
        },
        {
          "command": "ticketManager.assignToAi",
          "when": "(view == ticketManager.myIssues || view == ticketManager.boards) && viewItem == issue",
          "group": "ai@1"
        },
        {
          "command": "ticketManager.openAnalysisWindow",
          "when": "(view == ticketManager.myIssues || view == ticketManager.boards) && viewItem == issue && ticketManager.analysisGateEnabled",
          "group": "ai@2"
        }
      ],
      "commandPalette": [
        {
          "command": "ticketManager.searchIssuesActive",
          "when": "false"
        },
        {
          "command": "ticketManager.searchEpicsActive",
          "when": "false"
        },
        {
          "command": "ticketManager.searchBoardsActive",
          "when": "false"
        },
        {
          "command": "ticketManager.createIdea",
          "when": "config.ticketManager.enableCreateIdea"
        },
        {
          "command": "ticketManager.newProject",
          "when": "config.ticketManager.enableNewProject"
        },
        {
          "command": "ticketManager.toggleWorkMode"
        }
      ]
    },
    "configuration": {
      "title": "Ticket Manager",
      "properties": {
        "ticketManager.backendMode": {
          "type": "string",
          "enum": [
            "jiracloud",
            "demo",
            "github",
            "gitlab",
            "livefolder",
            "userworkspace"
          ],
          "enumItemLabels": [
            "Jira MCP",
            "Demo",
            "GitHub",
            "GitLab",
            "Live Folder",
            "User Workspace"
          ],
          "scope": "window",
          "description": "Choose whether the app uses Jira MCP, Demo, GitHub, GitLab, Live Folder, or User Workspace mode."
        },
        "ticketManager.connectionType": {
          "type": "string",
          "enum": [
            "stdio",
            "http"
          ],
          "enumItemLabels": [
            "stdio",
            "http"
          ],
          "default": "stdio",
          "scope": "window",
          "description": "Legacy Jira MCP transport selector retained for compatibility with existing setup flows and integration tests."
        },
        "ticketManager.stdioCommand": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Legacy Jira MCP stdio command retained for compatibility with existing setup flows and integration tests."
        },
        "ticketManager.stdioArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "description": "Legacy Jira MCP stdio command arguments retained for compatibility with existing setup flows and integration tests."
        },
        "ticketManager.stdioCwd": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Legacy Jira MCP stdio working directory retained for compatibility with existing setup flows and integration tests."
        },
        "ticketManager.httpUrl": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Legacy Jira MCP HTTP endpoint URL retained for compatibility with existing setup flows and integration tests."
        },
        "ticketManager.connections": {
          "type": "array",
          "scope": "window",
          "default": [],
          "description": "Named backend connections. Each entry is one configured backend instance (Jira server, GitLab host, Live Folder root, etc.). Use the Ticket Manager: Connections command to manage these via the UI.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "mode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for this connection. Used to reference it from tracked boards and secrets."
              },
              "name": {
                "type": "string",
                "description": "User-visible name."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "jiracloud",
                  "demo",
                  "github",
                  "gitlab",
                  "livefolder",
                  "userworkspace"
                ],
                "description": "Backend mode for this connection."
              },
              "settings": {
                "type": "object",
                "description": "Mode-specific settings (URL, project key, MCP command, folder path, etc.). Secrets are stored separately in VS Code SecretStorage."
              }
            }
          }
        },
        "ticketManager.boards": {
          "type": "array",
          "scope": "window",
          "default": [],
          "description": "Boards the user has explicitly chosen to track. Each entry references a connection by id and a board id native to that backend.",
          "items": {
            "type": "object",
            "required": [
              "connectionId",
              "boardId"
            ],
            "properties": {
              "connectionId": {
                "type": "string",
                "description": "Id of the connection this board belongs to (must match an entry in ticketManager.connections)."
              },
              "boardId": {
                "type": "string",
                "description": "Backend-native board identifier."
              },
              "displayName": {
                "type": "string",
                "description": "Optional override for the board's display name in the sidebar."
              }
            }
          }
        },
        "ticketManager.jiraMcpSiteUrl": {
          "type": "string",
          "default": "",
          "format": "uri",
          "scope": "window",
          "description": "Base URL of the Jira instance that MCP tools connect to in Jira MCP mode. Used for display and as a fallback when no MCP connection reports a URL."
        },
        "ticketManager.jiraMcpDefaultProjectKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Default Jira project key for new issues created through the Jira MCP backend when the form does not specify one."
        },
        "ticketManager.jiraMcpEpicKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional Jira Epic key associated with this workspace in Jira MCP mode. Boards follow this epic and Jira issue creation uses it as the default parent epic."
        },
        "ticketManager.jiraMcpEpicBoardName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional display name for the Jira MCP epic board in this workspace."
        },
        "ticketManager.jiraMcpBoardJql": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional Jira JQL query associated with this workspace in Jira MCP mode. When set, a JQL board is shown in addition to any linked epic board."
        },
        "ticketManager.jiraMcpBoardName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional display name for the Jira MCP JQL board in this workspace."
        },
        "ticketManager.enableCreateIdea": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Enable the **Create Idea** command and button (preview). When disabled, the command and its icon are hidden.",
          "tags": [
            "preview"
          ]
        },
        "ticketManager.enableNewProject": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Enable the **New Project** wizard (preview). When disabled, the command is hidden from the Command Palette.",
          "tags": [
            "preview"
          ]
        },
        "ticketManager.boardsSidebarPreviewMode": {
          "type": "string",
          "default": "classic",
          "enum": [
            "classic",
            "work"
          ],
          "enumItemLabels": [
            "Classic",
            "Work Mode"
          ],
          "scope": "window",
          "markdownDescription": "Select the **Boards** sidebar layout. **Classic** uses separate views (Boards, EPICs, My Issues, Sessions, Issue Details). **Work Mode** uses a board-centric layout with boards as cards and nested agent sessions.",
          "tags": [
            "preview"
          ]
        },
        "ticketManager.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Timeout, in milliseconds, for MCP requests."
        },
        "ticketManager.defaultPageSize": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 100,
          "description": "Number of issues to request per page."
        },
        "ticketManager.delivery.defaultBaseBranch": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Default base branch to use when a Jira ticket does not specify one (e.g. `main`, `develop`). When empty, the agent will post a clarification comment asking for the branch."
        },
        "ticketManager.delivery.autoMergeSubTasks": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "When enabled (default), completed sub-task branches are automatically merged into the feature branch without creating a merge request. A single MR is raised from the feature branch to the base branch after all sub-tasks complete. When disabled, each sub-task creates its own MR targeting the feature branch."
        },
        "ticketManager.workspaceMcpServerName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional workspace MCP server name to use from .vscode/mcp.json when Jira via MCP mode is not manually configured."
        },
        "ticketManager.userMcpServerRef": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional user/profile MCP server reference to use when Jira via MCP mode is not manually configured and no workspace MCP server is selected."
        },
        "ticketManager.priorityColors": {
          "type": "object",
          "default": {
            "Critical": "#DC2626",
            "Highest": "linear-gradient(to bottom, #DC2626, #EA580C)",
            "High": "#F59E0B",
            "Medium": "linear-gradient(to bottom, #F59E0B, #3B82F6)",
            "Low": "linear-gradient(to bottom, #3B82F6, #22C55E)",
            "Lowest": "#22C55E"
          },
          "description": "Colors for the priority indicator bar on ticket cards. Values can be hex colors or CSS linear gradients.",
          "properties": {
            "Critical": {
              "type": "string",
              "description": "Color for Critical priority tickets."
            },
            "Highest": {
              "type": "string",
              "description": "Color for Highest priority tickets."
            },
            "High": {
              "type": "string",
              "description": "Color for High priority tickets."
            },
            "Medium": {
              "type": "string",
              "description": "Color for Medium priority tickets."
            },
            "Low": {
              "type": "string",
              "description": "Color for Low priority tickets."
            },
            "Lowest": {
              "type": "string",
              "description": "Color for Lowest priority tickets."
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1029.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@ticket-manager/core": "*",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.1.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/vscode": "1.105.0",
    "@types/yazl": "^3.3.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2"
  }
}
