{
  "name": "ticket-manager",
  "displayName": "Ticket Manager",
  "version": "0.2.1",
  "publisher": "kam-ai-team",
  "description": "A compact issue and board sidebar for VS Code with Jira MCP, demo, and file-backed modes.",
  "license": "MIT",
  "homepage": "https://git.tools.dev.assaabloyglobalsolutions.net/traka/software/ai/tools/ticket-manager-extension",
  "repository": {
    "type": "git",
    "url": "https://git.tools.dev.assaabloyglobalsolutions.net/traka/software/ai/tools/ticket-manager-extension.git"
  },
  "pricing": "Free",
  "type": "commonjs",
  "main": "./out/extension.js",
  "icon": "media/marketplace-icon.png",
  "markdown": "EXTENSION.md",
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "issues",
    "tickets",
    "boards",
    "mcp",
    "activity-bar",
    "sidebar"
  ],
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "clean": "rimraf out",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch -p ./",
    "package": "npm run check-types && node esbuild.mjs --production",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "install:vsix": "node ./scripts/install-vsix.cjs",
    "install:code": "powershell -ExecutionPolicy Bypass -File ./scripts/install-vscode.ps1",
    "install:insiders": "powershell -ExecutionPolicy Bypass -File ./scripts/install-vscode-insiders.ps1",
    "install:cursor": "powershell -ExecutionPolicy Bypass -File ./scripts/install-cursor-extension.ps1",
    "install:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install.ps1",
    "uninstall:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install.ps1 -Uninstall",
    "build:install": "npm run build && npm run install:all",
    "publish:gitlab": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-gitlab.ps1",
    "install:from-gitlab": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-from-gitlab.ps1",
    "open:ticket-manager": "powershell -ExecutionPolicy Bypass -File ./scripts/launch-ticket-manager-vscode.ps1",
    "docs:commands": "node ./scripts/generate-command-reference.cjs",
    "bedrock:glm-test": "node ./scripts/test-bedrock-glm5.cjs",
    "bedrock:proxy": "node ./scripts/bedrock-sanitize-proxy.cjs",
    "check-types": "tsc --noEmit -p ./",
    "pretest": "rimraf out && tsc -p ./",
    "test": "vscode-test --label integration",
    "jira-mr-polling": "node ./JiraPollingService/node/standalone-cli.js",
    "jira-mr-polling:once": "node ./JiraPollingService/node/standalone-cli.js --once",
    "jira-mr-polling:test": "node --test ./JiraPollingService/node/standalone.test.js"
  },
  "contributes": {
    "icons": {
      "ticket-manager-ticket": {
        "description": "Ticket Manager ticket icon",
        "default": {
          "fontPath": "media/ticket-manager-icons.woff",
          "fontCharacter": "\\ea01"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ticketManager",
          "title": "Tickets",
          "icon": "media/activitybar-ticket.svg"
        },
        {
          "id": "ticketManagerWorkMode",
          "title": "Work Mode",
          "icon": "media/activitybar-ticket.svg"
        }
      ]
    },
    "views": {
      "ticketManager": [
        {
          "id": "ticketManager.setup",
          "name": "Configure Project",
          "type": "webview",
          "when": "!ticketManager.configured && ticketManager.boardsSidebarMode == classic"
        },
        {
          "id": "ticketManager.boards",
          "name": "Boards",
          "type": "webview",
          "when": "ticketManager.configured && ticketManager.boardsSidebarMode == classic"
        },
        {
          "id": "ticketManager.epics",
          "name": "EPICs",
          "type": "webview",
          "when": "ticketManager.configured && ticketManager.boardsSidebarMode == classic"
        },
        {
          "id": "ticketManager.myIssues",
          "name": "My Issues",
          "type": "webview",
          "when": "ticketManager.configured && ticketManager.boardsSidebarMode == classic"
        },
        {
          "id": "ticketManager.activeSessions",
          "name": "Sessions",
          "type": "webview",
          "when": "ticketManager.configured && ticketManager.boardsSidebarMode == classic"
        },
        {
          "id": "ticketManager.issueDetails",
          "name": "Issue Details",
          "type": "webview",
          "when": "ticketManager.configured && ticketManager.boardsSidebarMode == classic"
        }
      ],
      "ticketManagerWorkMode": [
        {
          "id": "ticketManager.workModeSetup",
          "name": "Configure Project",
          "type": "webview",
          "when": "!ticketManager.configured && ticketManager.boardsSidebarMode == work"
        },
        {
          "id": "ticketManager.workModeBoards",
          "name": "Work Mode",
          "type": "webview",
          "when": "ticketManager.configured && ticketManager.boardsSidebarMode == work"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ticketManager.myIssues",
        "contents": "Welcome to Ticket Manager!\\nConfigure a project to get started.\\n[$(plug) Connections & Boards](command:ticketManager.openConnectionsManager)\\n[$(gear) Configure Project (legacy)](command:ticketManager.openSetup)\\n\\nAlready configured? [Set Backend Mode](command:ticketManager.setBackendMode)"
      },
      {
        "view": "ticketManager.activeSessions",
        "contents": "Assigned AI work and live agent runs appear here. Double-click a session to open the full session details tab."
      },
      {
        "view": "ticketManager.issueDetails",
        "contents": "Select an issue in **My Issues** or on a board to inspect its details and transitions."
      },
      {
        "view": "ticketManager.epics",
        "contents": "Browse and manage EPICs for the current project scope."
      },
      {
        "view": "ticketManager.boards",
        "contents": "Browse boards and open a board tab.\n[$(add) Create Board](command:ticketManager.createBoard)\n[Set Board Search](command:ticketManager.setBoardSearchText)\n[Set Board Projects](command:ticketManager.setBoardProjects)\n[Set Board Types](command:ticketManager.setBoardTypes)"
      },
      {
        "view": "ticketManager.workModeBoards",
        "contents": "Browse boards in Work Mode and open a board tab.\n[$(add) Create Board](command:ticketManager.createBoard)\n[Set Board Search](command:ticketManager.setBoardSearchText)\n[Set Board Projects](command:ticketManager.setBoardProjects)\n[Set Board Types](command:ticketManager.setBoardTypes)"
      },
      {
        "view": "ticketManager.workModeSetup",
        "contents": "Welcome to Ticket Manager!\nConfigure a project to get started.\n[$(gear) Configure Project](command:ticketManager.openSetup)\n\nAlready configured? [Set Backend Mode](command:ticketManager.setBackendMode)"
      }
    ],
