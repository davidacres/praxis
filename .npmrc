@praxis:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
# Only resolve package versions published at least 7 days ago, so a freshly
# hijacked release is usually caught and pulled before it can land here.
# Applies when adding or upgrading; `npm ci` installs the lockfile as-is.
min-release-age=7
