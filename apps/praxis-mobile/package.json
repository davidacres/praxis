{
  "name": "@praxis/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "description": "Praxis mobile companion — the React Native app plus the client logic and platform-adapter contracts for continuing and executing work on a running desktop host.",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "check-types": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p .",
    "compile": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test \"out/**/*.test.js\"",
    "fixture": "tsc -p tsconfig.test.json && node out/main/runFixtureJourney.js"
  },
  "dependencies": {
    "@praxis/core": "*",
    "@praxis/mobile-protocol": "*",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-udp": "^4.1.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
