      "on": "success",
      "required": true
    },
    {
      "id": "e-review-gates",
      "from": "review",
      "to": "gates",
      "on": "success",
      "required": true
    },
    {
      "id": "e-qa-gates",
      "from": "qa",
      "to": "gates",
