      "on": "success",
      "required": true
    },
    {
      "id": "e-install-build",
      "from": "install",
      "to": "build",
      "on": "success",
      "required": true
    },
    {
      "id": "e-build-qa",
      "from": "build",
      "to": "qa",
      "on": "success",
      "required": true
    },
    {
      "id": "e-qa-repair",
      "from": "qa",
