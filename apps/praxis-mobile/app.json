{
  "expo": {
    "name": "Praxis",
    "slug": "praxis-mobile",
    "scheme": "praxis",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Praxis to scan a pairing code shown by your desktop."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Praxis asks for Face ID before you approve a workflow or allow an agent to act from your phone."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.acresweb.praxis.mobile",
      "appleTeamId": "WY4B2H77A5",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Praxis connects to your desktop on the local network to show and control active sessions."
      }
    },
    "android": {
      "package": "com.acresweb.praxis.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ]
    }
  }
}
