{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "App.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "screens/**/*.tsx",
    "renderer/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "main",
    "renderer/**/*.test.ts"
  ]
}
