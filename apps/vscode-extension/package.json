{
  "name": "praxis",
  "displayName": "Praxis",
  "version": "0.2.1",
  "publisher": "praxis",
  "author": {
    "name": "David Acres"
  },
  "description": "Issue and board sidebar for VS Code \u2014 Jira MCP, GitLab, GitHub, demo, and file-backed planning modes.",
  "license": "MIT",
  "homepage": "https://github.com/davidacres/praxis",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidacres/praxis.git"
  },
  "pricing": "Free",
  "type": "commonjs",
  "main": "./out/extension.js",
  "icon": "media/marketplace-icon.png",
  "markdown": "EXTENSION.md",
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "issues",
    "tickets",
    "boards",
    "mcp",
    "activity-bar",
    "sidebar"
  ],
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "clean": "rimraf out",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch -p ./",
    "package": "npm run check-types && node esbuild.mjs --production",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "install:vsix": "node ./scripts/install-vsix.cjs",
    "install:code": "powershell -ExecutionPolicy Bypass -File ./scripts/install-vscode.ps1",
    "install:insiders": "powershell -ExecutionPolicy Bypass -File ./scripts/install-vscode-insiders.ps1",
    "install:cursor": "powershell -ExecutionPolicy Bypass -File ./scripts/install-cursor-extension.ps1",
    "install:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install.ps1",
    "uninstall:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install.ps1 -Uninstall",
    "build:install": "npm run build && npm run install:all",
    "publish:gitlab": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-gitlab.ps1",
    "publish:github": "./scripts/publish-github.sh",
    "install:from-gitlab": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-from-gitlab.ps1",
    "open:praxis": "powershell -ExecutionPolicy Bypass -File ./scripts/launch-praxis-vscode.ps1",
    "docs:commands": "node ./scripts/generate-command-reference.cjs",
    "bedrock:glm-test": "node ./scripts/test-bedrock-glm5.cjs",
    "bedrock:proxy": "node ./scripts/bedrock-sanitize-proxy.cjs",
    "check-types": "tsc --noEmit -p ./",
    "pretest": "rimraf out && tsc -p ./",
    "test": "vscode-test --label integration",
    "jira-mr-polling": "node ./JiraPollingService/node/standalone-cli.js",
    "jira-mr-polling:once": "node ./JiraPollingService/node/standalone-cli.js --once",
    "jira-mr-polling:test": "node --test ./JiraPollingService/node/standalone.test.js"
  },
  "contributes": {
    "icons": {
      "praxis-ticket": {
        "description": "Praxis ticket icon",
        "default": {
          "fontPath": "media/praxis-icons.woff",
          "fontCharacter": "\\ea01"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "praxis",
          "title": "Tickets",
          "icon": "media/activitybar-praxis.svg"
        },
        {
          "id": "praxisWorkMode",
          "title": "Work Mode",
          "icon": "media/activitybar-praxis.svg"
        }
      ]
    },
    "views": {
      "praxis": [
        {
          "id": "praxis.setup",
          "name": "Configure Project",
          "type": "webview",
          "when": "!praxis.configured && praxis.boardsSidebarMode == classic"
        },
        {
          "id": "praxis.boards",
          "name": "Boards",
          "type": "webview",
          "when": "praxis.configured && praxis.boardsSidebarMode == classic"
        },
        {
          "id": "praxis.epics",
          "name": "EPICs",
          "type": "webview",
          "when": "praxis.configured && praxis.boardsSidebarMode == classic"
        },
        {
          "id": "praxis.myIssues",
          "name": "My Issues",
          "type": "webview",
          "when": "praxis.configured && praxis.boardsSidebarMode == classic"
        },
        {
          "id": "praxis.activeSessions",
          "name": "Sessions",
          "type": "webview",
          "when": "praxis.configured && praxis.boardsSidebarMode == classic"
        },
        {
          "id": "praxis.issueDetails",
          "name": "Issue Details",
          "type": "webview",
          "when": "praxis.configured && praxis.boardsSidebarMode == classic"
        }
      ],
      "praxisWorkMode": [
        {
          "id": "praxis.workModeSetup",
          "name": "Configure Project",
          "type": "webview",
          "when": "!praxis.configured && praxis.boardsSidebarMode == work"
        },
        {
          "id": "praxis.workModeBoards",
          "name": "Work Mode",
          "type": "webview",
          "when": "praxis.configured && praxis.boardsSidebarMode == work"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "praxis.myIssues",
        "contents": "Welcome to Praxis!\\nConfigure a project to get started.\\n[$(plug) Connections & Boards](command:praxis.openConnectionsManager)\\n[$(gear) Configure Project (legacy)](command:praxis.openSetup)\\n\\nAlready configured? [Set Backend Mode](command:praxis.setBackendMode)"
      },
      {
        "view": "praxis.activeSessions",
        "contents": "Assigned AI work and live agent runs appear here. Double-click a session to open the full session details tab."
      },
      {
        "view": "praxis.issueDetails",
        "contents": "Select an issue in **My Issues** or on a board to inspect its details and transitions."
      },
      {
        "view": "praxis.epics",
        "contents": "Browse and manage EPICs for the current project scope."
      },
      {
        "view": "praxis.boards",
        "contents": "Browse boards and open a board tab.\n[$(add) Create Board](command:praxis.createBoard)\n[Set Board Search](command:praxis.setBoardSearchText)\n[Set Board Projects](command:praxis.setBoardProjects)\n[Set Board Types](command:praxis.setBoardTypes)"
      },
      {
        "view": "praxis.workModeBoards",
        "contents": "Browse boards in Work Mode and open a board tab.\n[$(add) Create Board](command:praxis.createBoard)\n[Set Board Search](command:praxis.setBoardSearchText)\n[Set Board Projects](command:praxis.setBoardProjects)\n[Set Board Types](command:praxis.setBoardTypes)"
      },
      {
        "view": "praxis.workModeSetup",
        "contents": "Welcome to Praxis!\nConfigure a project to get started.\n[$(gear) Configure Project](command:praxis.openSetup)\n\nAlready configured? [Set Backend Mode](command:praxis.setBackendMode)"
      }
    ],
