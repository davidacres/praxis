    "menus": {
      "view/title": [
        {
          "command": "praxis.refresh",
          "when": "view == praxis.myIssues",
          "group": "navigation@1"
        },
        {
          "command": "praxis.refresh",
          "when": "view == praxis.epics",
          "group": "navigation@1"
        },
        {
          "command": "praxis.createEpic",
          "when": "view == praxis.epics",
          "group": "navigation@2"
        },
        {
          "command": "praxis.searchEpics",
          "when": "view == praxis.epics && !praxis.epicsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "praxis.searchEpicsActive",
          "when": "view == praxis.epics && praxis.epicsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "praxis.createIssue",
          "when": "view == praxis.myIssues",
          "group": "navigation@2"
        },
        {
          "command": "praxis.createIdea",
          "when": "view == praxis.myIssues && config.praxis.enableCreateIdea",
          "group": "navigation@2"
        },
        {
          "command": "praxis.searchIssues",
          "when": "view == praxis.myIssues && !praxis.issuesSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "praxis.searchIssuesActive",
          "when": "view == praxis.myIssues && praxis.issuesSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "praxis.setProjects",
          "when": "view == praxis.myIssues",
          "group": "navigation@4"
        },
        {
          "command": "praxis.setParentScope",
          "when": "view == praxis.myIssues",
          "group": "navigation@5"
        },
        {
          "command": "praxis.refresh",
          "when": "view == praxis.boards",
          "group": "navigation@1"
        },
        {
          "command": "praxis.createBoard",
          "when": "view == praxis.boards",
          "group": "navigation@2"
        },
        {
          "command": "praxis.searchBoards",
          "when": "view == praxis.boards && !praxis.boardsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "praxis.searchBoardsActive",
          "when": "view == praxis.boards && praxis.boardsSearchActive",
          "group": "navigation@3"
        },
        {
          "command": "praxis.setBoardProjects",
          "when": "view == praxis.boards",
          "group": "navigation@4"
        },
        {
          "command": "praxis.setBoardTypes",
          "when": "view == praxis.boards",
          "group": "navigation@5"
        },
        {
          "command": "praxis.openConnectionsManager",
          "when": "view == praxis.boards",
          "group": "navigation@6"
        },
        {
          "command": "praxis.clearBoardFilters",
          "when": "view == praxis.boards"
        },
        {
          "command": "praxis.setBackendMode",
          "when": "view == praxis.boards"
        },
        {
          "command": "praxis.toggleWorkMode",
          "when": "view == praxis.boards",
          "group": "navigation@8"
        },
        {
          "command": "praxis.configureConnection",
          "when": "view == praxis.myIssues && praxis.mode == jira"
        },
        {
          "command": "praxis.setBackendMode",
          "when": "view == praxis.myIssues"
        },
        {
          "command": "praxis.checkConnection",
          "when": "view == praxis.myIssues"
        },
        {
          "command": "praxis.setStatuses",
          "when": "view == praxis.myIssues"
        },
        {
          "command": "praxis.setIssueTypes",
          "when": "view == praxis.myIssues"
        },
        {
          "command": "praxis.toggleAssigneeMode",
          "when": "view == praxis.myIssues"
        },
        {
          "command": "praxis.clearParentScope",
          "when": "view == praxis.myIssues"
        },
        {
          "command": "praxis.clearFilters",
          "when": "view == praxis.myIssues"
        },
        {
          "command": "praxis.refresh",
          "when": "view == praxis.activeSessions",
          "group": "navigation@1"
        },
        {
          "command": "praxis.changeStatus",
          "when": "view == praxis.issueDetails",
          "group": "navigation@1"
        },
        {
          "command": "praxis.openInBrowser",
          "when": "view == praxis.issueDetails",
          "group": "navigation@2"
        },
        {
          "command": "praxis.openIssueFullDetails",
          "when": "view == praxis.issueDetails",
          "group": "navigation@3"
        },
        {
          "command": "praxis.assignToAi",
          "when": "view == praxis.issueDetails",
          "group": "navigation@4"
        },
        {
          "command": "praxis.openAnalysisWindow",
          "when": "view == praxis.issueDetails && praxis.analysisGateEnabled",
          "group": "navigation@4.5"
        },
        {
          "command": "praxis.assignWorkflowPack",
          "when": "view == praxis.issueDetails",
          "group": "navigation@5"
        },
        {
          "command": "praxis.unassignAi",
          "when": "view == praxis.issueDetails",
          "group": "navigation@6"
        },
        {
          "command": "praxis.toggleWorkMode",
          "when": "view == praxis.workModeBoards",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "praxis.openInBrowser",
          "when": "view == praxis.myIssues && viewItem == issue",
          "group": "inline@1"
        },
        {
          "command": "praxis.changeStatus",
          "when": "view == praxis.myIssues && viewItem == issue",
          "group": "inline@2"
        },
        {
          "command": "praxis.copyKey",
          "when": "view == praxis.myIssues && viewItem == issue",
          "group": "secondary"
        },
        {
          "command": "praxis.loadMore",
          "when": "view == praxis.myIssues && viewItem == loadMore",
          "group": "inline@1"
        },
        {
          "command": "praxis.openBoard",
          "when": "view == praxis.boards && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "praxis.configureBoardColumns",
          "when": "view == praxis.boards && viewItem == board",
          "group": "inline@2"
        },
        {
          "command": "praxis.configureBoardColumns",
          "when": "view == praxis.workModeBoards && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "praxis.createIssue",
          "when": "view == praxis.boards && viewItem == board",
          "group": "inline@3"
        },
        {
          "command": "praxis.openIssueFullDetails",
          "when": "view == praxis.issueDetails && viewItem == issueKey",
          "group": "inline@1"
        },
        {
          "command": "praxis.assignToAi",
          "when": "(view == praxis.myIssues || view == praxis.boards) && viewItem == issue",
          "group": "ai@1"
        },
        {
          "command": "praxis.openAnalysisWindow",
          "when": "(view == praxis.myIssues || view == praxis.boards) && viewItem == issue && praxis.analysisGateEnabled",
          "group": "ai@2"
        }
      ],
      "commandPalette": [
        {
          "command": "praxis.searchIssuesActive",
          "when": "false"
        },
        {
          "command": "praxis.searchEpicsActive",
          "when": "false"
        },
        {
          "command": "praxis.searchBoardsActive",
          "when": "false"
        },
        {
          "command": "praxis.createIdea",
          "when": "config.praxis.enableCreateIdea"
        },
        {
          "command": "praxis.newProject",
          "when": "config.praxis.enableNewProject"
        },
        {
          "command": "praxis.toggleWorkMode"
        }
      ]
    },
    "configuration": {
      "title": "Praxis",
      "properties": {
        "praxis.backendMode": {
          "type": "string",
          "enum": [
            "jiracloud",
            "demo",
            "github",
            "gitlab",
            "livefolder",
            "userworkspace"
          ],
          "enumItemLabels": [
            "Jira MCP",
            "Demo",
            "GitHub",
            "GitLab",
            "Live Folder",
            "User Workspace"
          ],
          "scope": "window",
          "description": "Choose whether the app uses Jira MCP, Demo, GitHub, GitLab, Live Folder, or User Workspace mode."
        },
        "praxis.connectionType": {
          "type": "string",
          "enum": [
            "stdio",
            "http"
          ],
          "enumItemLabels": [
            "stdio",
            "http"
          ],
          "default": "stdio",
          "scope": "window",
          "description": "Legacy Jira MCP transport selector retained for compatibility with existing setup flows and integration tests."
        },
        "praxis.stdioCommand": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Legacy Jira MCP stdio command retained for compatibility with existing setup flows and integration tests."
        },
        "praxis.stdioArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "description": "Legacy Jira MCP stdio command arguments retained for compatibility with existing setup flows and integration tests."
        },
        "praxis.stdioCwd": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Legacy Jira MCP stdio working directory retained for compatibility with existing setup flows and integration tests."
        },
        "praxis.httpUrl": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Legacy Jira MCP HTTP endpoint URL retained for compatibility with existing setup flows and integration tests."
        },
        "praxis.connections": {
          "type": "array",
          "scope": "window",
          "default": [],
          "description": "Named backend connections. Each entry is one configured backend instance (Jira server, GitLab host, Live Folder root, etc.). Use the Praxis: Connections command to manage these via the UI.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "mode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for this connection. Used to reference it from tracked boards and secrets."
              },
              "name": {
                "type": "string",
                "description": "User-visible name."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "jiracloud",
                  "demo",
                  "github",
                  "gitlab",
                  "livefolder",
                  "userworkspace"
                ],
                "description": "Backend mode for this connection."
              },
              "settings": {
                "type": "object",
                "description": "Mode-specific settings (URL, project key, MCP command, folder path, etc.). Secrets are stored separately in VS Code SecretStorage."
              }
            }
          }
        },
        "praxis.boards": {
          "type": "array",
          "scope": "window",
          "default": [],
          "description": "Boards the user has explicitly chosen to track. Each entry references a connection by id and a board id native to that backend.",
          "items": {
            "type": "object",
            "required": [
              "connectionId",
              "boardId"
            ],
            "properties": {
              "connectionId": {
                "type": "string",
                "description": "Id of the connection this board belongs to (must match an entry in praxis.connections)."
              },
              "boardId": {
                "type": "string",
                "description": "Backend-native board identifier."
              },
              "displayName": {
                "type": "string",
                "description": "Optional override for the board's display name in the sidebar."
              }
            }
          }
        },
        "praxis.jiraMcpSiteUrl": {
          "type": "string",
          "default": "",
          "format": "uri",
          "scope": "window",
          "description": "Base URL of the Jira instance that MCP tools connect to in Jira MCP mode. Used for display and as a fallback when no MCP connection reports a URL."
        },
        "praxis.jiraMcpDefaultProjectKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Default Jira project key for new issues created through the Jira MCP backend when the form does not specify one."
        },
        "praxis.jiraMcpEpicKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional Jira Epic key associated with this workspace in Jira MCP mode. Boards follow this epic and Jira issue creation uses it as the default parent epic."
        },
        "praxis.jiraMcpEpicBoardName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional display name for the Jira MCP epic board in this workspace."
        },
        "praxis.jiraMcpBoardJql": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional Jira JQL query associated with this workspace in Jira MCP mode. When set, a JQL board is shown in addition to any linked epic board."
        },
        "praxis.jiraMcpBoardName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional display name for the Jira MCP JQL board in this workspace."
        },
        "praxis.enableCreateIdea": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Enable the **Create Idea** command and button (preview). When disabled, the command and its icon are hidden.",
          "tags": [
            "preview"
          ]
        },
        "praxis.enableNewProject": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Enable the **New Project** wizard (preview). When disabled, the command is hidden from the Command Palette.",
          "tags": [
            "preview"
          ]
        },
        "praxis.boardsSidebarPreviewMode": {
          "type": "string",
          "default": "classic",
          "enum": [
            "classic",
            "work"
          ],
          "enumItemLabels": [
            "Classic",
            "Work Mode"
          ],
          "scope": "window",
          "markdownDescription": "Select the **Boards** sidebar layout. **Classic** uses separate views (Boards, EPICs, My Issues, Sessions, Issue Details). **Work Mode** uses a board-centric layout with boards as cards and nested agent sessions.",
          "tags": [
            "preview"
          ]
        },
        "praxis.liveFolderPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Path to the plans folder used in **Live Folder** mode. The extension reads and writes the markdown planning files under this directory. Set per workspace; a global value is ignored for workspace projects."
        },
        "praxis.liveFolderProjectKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Project key prefix for issues synthesised from the Live Folder plans tree (e.g. APP produces APP-F01, APP-S01-1)."
        },
        "praxis.liveFolderProjectName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Display name for the Live Folder project."
        },
        "praxis.liveFolderAllowIssueCreation": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "When enabled (default), creating an issue in **Live Folder** mode writes a new markdown file into the plans tree. When disabled, the folder is treated as read-only."
        },
        "praxis.ai.provider": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "vercel-gateway"
          ],
          "enumItemLabels": [
            "None",
            "Vercel AI Gateway"
          ],
          "scope": "window",
          "description": "Active AI provider for analysis and agent workflows."
        },
        "praxis.ai.credential": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Credential (API key or token) for the active AI provider. Prefer the extension's secret storage; this setting is a fallback."
        },
        "praxis.ai.agentName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Agent or model name to use with the active AI provider."
        },
        "praxis.ai.runtimePath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Path to the CLI runtime for CLI-based AI providers."
        },
        "praxis.ai.vercelUrl": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Base URL for the Vercel AI Gateway. Leave empty to use the default endpoint."
        },
        "praxis.gitlabProjectPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "GitLab project path (group/subgroup/project) for GitLab mode."
        },
        "praxis.gitlabListAllAccessibleBoards": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "When enabled, list every GitLab board the token can access rather than only those under the configured project."
        },
        "praxis.gitlabSelectedBoardRefs": {
          "type": "array",
          "default": [],
          "scope": "window",
          "items": {
            "type": "string"
          },
          "description": "References of the GitLab boards to track."
        },
        "praxis.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Timeout, in milliseconds, for MCP requests."
        },
        "praxis.defaultPageSize": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 100,
          "description": "Number of issues to request per page."
        },
        "praxis.delivery.defaultBaseBranch": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Default base branch to use when a Jira ticket does not specify one (e.g. `main`, `develop`). When empty, the agent will post a clarification comment asking for the branch."
        },
        "praxis.delivery.autoMergeSubTasks": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "When enabled (default), completed sub-task branches are automatically merged into the feature branch without creating a merge request. A single MR is raised from the feature branch to the base branch after all sub-tasks complete. When disabled, each sub-task creates its own MR targeting the feature branch."
        },
        "praxis.workspaceMcpServerName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional workspace MCP server name to use from .vscode/mcp.json when Jira via MCP mode is not manually configured."
        },
        "praxis.userMcpServerRef": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional user/profile MCP server reference to use when Jira via MCP mode is not manually configured and no workspace MCP server is selected."
        },
        "praxis.priorityColors": {
          "type": "object",
          "default": {
            "Critical": "#DC2626",
            "Highest": "linear-gradient(to bottom, #DC2626, #EA580C)",
            "High": "#F59E0B",
            "Medium": "linear-gradient(to bottom, #F59E0B, #3B82F6)",
            "Low": "linear-gradient(to bottom, #3B82F6, #22C55E)",
            "Lowest": "#22C55E"
          },
          "description": "Colors for the priority indicator bar on ticket cards. Values can be hex colors or CSS linear gradients.",
          "properties": {
            "Critical": {
              "type": "string",
              "description": "Color for Critical priority tickets."
            },
            "Highest": {
              "type": "string",
              "description": "Color for Highest priority tickets."
            },
            "High": {
              "type": "string",
              "description": "Color for High priority tickets."
            },
            "Medium": {
              "type": "string",
              "description": "Color for Medium priority tickets."
            },
            "Low": {
              "type": "string",
              "description": "Color for Low priority tickets."
            },
            "Lowest": {
              "type": "string",
              "description": "Color for Lowest priority tickets."
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1029.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@praxis/core": "*",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.1.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/vscode": "1.105.0",
    "@types/yazl": "^3.3.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2"
  }
}
