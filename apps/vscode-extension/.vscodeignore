# Editor / IDE files
.vscode/**
.vscode-test/**
.vscode-test.mjs
.praxis-test/**

# Source / build inputs (we ship the esbuild bundle)
src/**
esbuild.mjs
tsconfig.json
scripts/**
.esbuild/**

# Build outputs we don't need inside the .vsix
out/**/*.map
out/**/*.tsbuildinfo
artifacts/**

# Plans / speculative docs (now under docs/plans)
docs/**
.claude/**

# Misc
.gitignore
.gitlab-ci.yml
.git/**
.github/**
CLAUDE.md
latest
test-output.txt
test-failures.txt
.cache/**

# Source maps and TS sources anywhere in the package
**/*.map
**/*.ts
**/*.tsbuildinfo

# Source / alternate icons not referenced by package.json contributes.
# Keep activitybar-ticket.svg and praxis-icons.woff — they are
# required at runtime for the activity bar and status-bar product icon.
media/activitybar-jira.svg
media/search-active-light.svg
media/search-active-dark.svg
media/ticket.svg

