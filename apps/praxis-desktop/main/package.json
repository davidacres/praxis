{
  "name": "@praxis/desktop-main",
  "version": "0.2.1",
  "description": "Praxis desktop workspace for planning, tickets, and delivery.",
  "author": "Praxis",
  "repository": "https://github.com/davidacres/praxis.git",
  "private": true,
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "check-types": "tsc --noEmit -p .",
    "compile": "tsc -p .",
    "copy-renderer": "node scripts/copy-renderer.cjs",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:mac:publish": "electron-builder --mac dmg --publish always",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:win:publish": "electron-builder --win nsis --publish always",
    "predist": "npm run copy-renderer",
    "rebuild-terminal": "npm rebuild node-pty --build-from-source",
    "start": "npm run compile && electron .",
    "test:e2e": "npm run compile && npx playwright test",
    "test:git": "npm run compile && node --test out/main/gitService.test.js out/main/adapters/jsonKeyValueStore.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@praxis/core": "*",
    "electron-updater": "^6.8.9",
    "jsonc-parser": "^3.3.1",
    "node-pty": "^1.1.0",
    "tar": "^7.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.5.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.2"
  },
  "build": {
    "appId": "com.praxis.app",
    "productName": "Praxis",
    "directories": {
      "output": "dist"
    },
    "electronVersion": "43.4.1",
    "npmRebuild": true,
    "buildDependenciesFromSource": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "out/**",
      "renderer/**",
      {
        "from": "../core/out",
        "to": "node_modules/@praxis/core/out",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../core/package.json",
        "to": "node_modules/@praxis/core/package.json"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 130,
          "y": 225,
          "type": "file"
        },
        {
          "x": 410,
          "y": 225,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Praxis",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "${env.PRAXIS_PUBLISH_OWNER}",
        "repo": "${env.PRAXIS_PUBLISH_REPO}"
      }
    ]
  }
}
