{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Praxis",
  "version": "0.6.1",
  "identifier": "com.praxis.app",
  "build": {
    "frontendDist": "../renderer/dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "url": "tauri.html",
      "title": "Praxis",
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 12, "y": 19 },
      "width": 1440,
      "height": 960,
      "minWidth": 900,
      "minHeight": 600,
      "devtools": true
    }],
    "security": {
      "capabilities": ["main", "child-browsers"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost tauri: http://tauri.localhost ws: http:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
