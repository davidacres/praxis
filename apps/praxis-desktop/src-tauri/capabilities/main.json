{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local Praxis UI can invoke the desktop contract. Remote and child webviews receive no capability.",
  "local": true,
  "windows": ["main"],
  "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-start-dragging", "core:window:allow-toggle-maximize", "allow-desktop-contract"]
}
