          "kind": "findings",
          "required": true
        }
      ],
      "successExitCodes": [
        0
      ],
      "args": [
        "tsc",
        "--noEmit"
      ],
      "satisfiesGate": "qa"
    },
    {
      "id": "test",
      "name": "Unit tests & coverage",
      "x": 1080,
      "y": 40,
      "inputs": [
