          "id": "sca-findings",
          "kind": "findings",
          "required": true
        }
      ],
      "successExitCodes": [
        0
      ],
      "args": [
        "--format=sarif",
        "--output=osv.sarif",
        "."
      ],
      "satisfiesGate": "security"
    },
    {
      "id": "review",
