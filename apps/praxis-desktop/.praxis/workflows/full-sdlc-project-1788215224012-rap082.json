          "kind": "findings",
          "required": true
        }
      ],
      "successExitCodes": [
        0
      ],
      "args": [
        "detect",
        "--no-git",
        "--report-format=sarif",
        "--report-path=gitleaks.sarif"
      ],
      "satisfiesGate": "security"
    },
    {
      "id": "sca",
      "name": "SCA scan",
      "x": 560,
      "y": 460,
      "inputs": [
        "change-diff"
      ],
      "type": "check",
