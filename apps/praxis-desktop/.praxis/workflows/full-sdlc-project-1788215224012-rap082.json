        {
          "id": "review-findings",
          "kind": "findings",
          "required": true
        }
      ],
      "mutatesWorktree": false,
      "satisfiesGate": "review",
      "maxAttempts": 3,
      "modelTier": "standard"
    },
    {
      "id": "gates",
      "name": "SDLC Gates",
      "x": 1340,
      "y": 40,
      "inputs": [],
      "type": "join",
      "mode": "all"
    },
    {
      "id": "approve",
      "name": "Approve",
      "x": 1600,
      "y": 40,
      "inputs": [
        "change-diff",
        "review-findings"
      ],
      "type": "approval",
      "prompt": "All QA, Security, and Code Review quality gates have passed. Sign off on changes?",
      "requiredGates": [
        "qa",
        "security",
        "review"
      ],
      "allowBypass": false,
      "gateThresholds": {
        "qa": [
          {
            "type": "metric",
            "metric": "coverage",
            "operator": ">=",
            "value": 80
          }
        ],
        "security": [
          {
            "type": "severity",
            "maxCount": 0,
            "severityLevel": "high"
          }
        ],
        "review": [
          {
            "type": "severity",
            "maxCount": 0,
            "severityLevel": "high"
          }
        ]
      }
    }
