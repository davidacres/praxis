{
  "schemaVersion": 1,
  "id": "full-sdlc",
  "name": "Full SDLC",
  "description": "Praxis delivery: plan, implement, then type check, unit tests, SAST, secrets, SCA and code review gates before sign-off.",
  "trigger": "ticket",
  "scope": "project",
  "version": 2,
  "entryNodeId": "plan",
  "createdAt": "2026-10-24T15:31:09.446Z",
  "updatedAt": "2026-10-25T00:00:00.000Z",
  "nodes": [
    {
      "type": "agent-task",
      "id": "plan",
      "name": "Plan",
      "x": 0,
      "y": 160,
      "inputs": [],
      "agent": {
        "agentId": "praxis-planner",
        "profileId": "praxis-planner",
        "hostId": "praxis-planner",
        "scope": "global",
        "toolMode": "read-only"
      },
      "instructions": "Analyze requirements, verify existing architecture, and produce structured plan.",
      "outputs": [
        {
          "id": "plan-doc",
          "kind": "plan",
          "required": true
        }
      ],
      "mutatesWorktree": false,
      "modelTier": "fast"
    },
    {
      "type": "agent-task",
      "id": "implement",
      "name": "Implement",
      "x": 200,
      "y": 160,
      "inputs": [
        "plan-doc"
      ],
      "agent": {
        "agentId": "praxis-implementer",
        "profileId": "praxis-implementer",
        "hostId": "praxis-implementer",
        "scope": "global",
        "toolMode": "full",
        "skillNames": [
          "verification-report",
          "visual-verification"
        ]
      },
      "instructions": "Implement changes matching plan specifications, verify changes by running automated tests and fixing any broken or outdated tests, and commit clean changes to the branch.",
      "outputs": [
        {
          "id": "change-diff",
          "kind": "diff",
          "required": true
        }
      ],
      "mutatesWorktree": true,
      "maxAttempts": 3,
      "modelTier": "strong"
    },
    {
      "type": "check",
      "id": "install",
      "name": "Install dependencies",
      "x": 320,
      "y": 60,
      "inputs": [
        "change-diff"
      ],
      "command": "npm",
      "args": [
        "ci",
        "--registry=https://registry.npmjs.org/"
      ],
      "successExitCodes": [
        0
      ],
      "timeoutMs": 600000,
      "maxAttempts": 2,
      "outputs": [
        {
          "id": "install-log",
          "kind": "log",
          "required": true
        }
      ]
    },
    {
      "type": "check",
      "id": "build",
      "name": "Build",
      "x": 440,
      "y": 130,
      "inputs": [
        "change-diff"
      ],
      "command": "npm",
      "args": [
        "run",
        "build",
        "--if-present"
      ],
      "successExitCodes": [
        0
      ],
      "timeoutMs": 900000,
      "outputs": [
        {
          "id": "build-log",
          "kind": "log",
          "required": false
        }
      ]
    },
    {
      "type": "check",
      "id": "typecheck",
      "name": "Type check",
      "x": 440,
      "y": 60,
      "inputs": [
        "change-diff"
      ],
      "command": "npm",
      "args": [
        "run",
        "check-types"
      ],
      "successExitCodes": [
        0
      ],
      "outputs": [
        {
          "id": "typecheck-findings",
          "kind": "findings",
          "required": false
        }
      ],
      "satisfiesGate": "qa"
    },
    {
      "type": "check",
      "id": "test",
      "name": "Unit tests",
      "x": 560,
      "y": 120,
      "inputs": [
        "change-diff"
      ],
      "command": "npm",
      "args": [
        "run",
        "test:core"
      ],
      "successExitCodes": [
        0
      ],
      "outputs": [
        {
          "id": "test-findings",
          "kind": "findings",
          "required": false
        }
      ],
      "satisfiesGate": "qa"
    },
    {
      "type": "check",
      "id": "sast",
      "name": "SAST scan",
      "x": 440,
      "y": 200,
      "inputs": [
        "change-diff"
      ],
      "command": "semgrep",
      "args": [
        "scan",
        "--config=auto",
        "--baseline-commit={baseCommit}",
        "--sarif",
        "--output=semgrep.sarif"
      ],
      "successExitCodes": [
        0
      ],
      "outputs": [
        {
          "id": "sast-findings",
          "kind": "findings",
          "required": true,
          "adapter": "sarif"
        }
      ],
      "satisfiesGate": "security",
      "reportPath": "semgrep.sarif",
      "adapter": "sarif"
    },
    {
      "type": "check",
      "id": "secrets",
      "name": "Secret scan",
      "x": 440,
      "y": 260,
      "inputs": [
        "change-diff"
      ],
      "command": "gitleaks",
      "args": [
        "detect",
        "--no-git",
        "--report-format=sarif",
        "--report-path=gitleaks.sarif"
      ],
      "successExitCodes": [
        0
      ],
      "outputs": [
        {
          "id": "secret-findings",
          "kind": "findings",
          "required": true,
          "adapter": "sarif"
        }
      ],
      "satisfiesGate": "security",
      "reportPath": "gitleaks.sarif",
      "adapter": "sarif"
    },
    {
      "type": "check",
      "id": "sca",
      "name": "SCA scan",
      "x": 440,
      "y": 320,
      "inputs": [
        "change-diff"
      ],
      "command": "osv-scanner",
      "args": [
        "scan",
        "source",
        "--no-ignore",
        "--format",
        "sarif",
        "--output-file",
        "osv.sarif",
        "."
      ],
      "successExitCodes": [
        0
      ],
      "outputs": [
        {
          "id": "sca-findings",
          "kind": "findings",
          "required": true,
          "adapter": "sarif"
        }
      ],
      "satisfiesGate": "security",
      "reportPath": "osv.sarif",
      "adapter": "sarif"
    },
    {
      "type": "agent-task",
      "id": "review",
      "name": "Structured code review",
      "x": 440,
      "y": 400,
      "inputs": [
        "change-diff"
      ],
      "agent": {
        "agentId": "praxis-reviewer",
        "scope": "global",
        "toolMode": "read-only"
      },
      "instructions": "Review changes against quality and security criteria and return structured findings.",
      "outputs": [
        {
          "id": "review-findings",
          "kind": "findings",
          "required": true
        }
      ],
      "mutatesWorktree": false,
      "satisfiesGate": "review",
      "maxAttempts": 3,
      "modelTier": "standard"
    },
    {
      "type": "join",
      "id": "gates",
      "name": "SDLC Gates",
      "x": 680,
      "y": 160,
      "inputs": [],
      "mode": "all"
    },
    {
      "type": "approval",
      "id": "approve",
      "name": "Approve",
      "x": 900,
      "y": 160,
      "inputs": [
        "change-diff",
        "review-findings"
      ],
      "prompt": "All QA, Security, and Code Review quality gates have passed. Sign off on changes?",
      "requiredGates": [
        "qa",
        "security",
        "review"
      ],
      "allowBypass": false,
      "gateThresholds": {
        "security": [
          {
            "type": "severity",
            "severityLevel": "high",
            "maxCount": 0
          }
        ],
        "review": [
          {
            "type": "severity",
            "severityLevel": "high",
            "maxCount": 0
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "e-plan-impl",
      "from": "plan",
      "to": "implement",
      "on": "success",
